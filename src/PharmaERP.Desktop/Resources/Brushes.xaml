<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <!-- Primary Palette (Deep Corporate Slate & Medical Teal) -->
    <Color x:Key="Color.Primary">#0F172A</Color>
    <Color x:Key="Color.Primary.Light">#1E293B</Color>
    <Color x:Key="Color.Primary.Dark">#0A0F1D</Color>

    <Color x:Key="Color.Accent">#0D9488</Color>
    <Color x:Key="Color.Accent.Hover">#0F766E</Color>
    <Color x:Key="Color.Accent.Muted">#CCFBF1</Color>

    <!-- Neutrals & Surfaces -->
    <Color x:Key="Color.Background">#F8FAFC</Color>
    <Color x:Key="Color.Surface">#FFFFFF</Color>
    <Color x:Key="Color.Surface.Muted">#F1F5F9</Color>
    <Color x:Key="Color.Surface.Hover">#E2E8F0</Color>

    <!-- Text & Foreground -->
    <Color x:Key="Color.Text.Primary">#0F172A</Color>
    <Color x:Key="Color.Text.Secondary">#475569</Color>
    <Color x:Key="Color.Text.Muted">#94A3B8</Color>
    <Color x:Key="Color.Text.Inverse">#FFFFFF</Color>

    <!-- Borders -->
    <Color x:Key="Color.Border">#E2E8F0</Color>
    <Color x:Key="Color.Border.Light">#CBD5E1</Color>
    <Color x:Key="Color.FocusRing">#0D9488</Color>

    <!-- Status Colors -->
    <Color x:Key="Color.Status.Success">#16A34A</Color>
    <Color x:Key="Color.Status.Success.Bg">#DCFCE7</Color>
    <Color x:Key="Color.Status.Warning">#D97706</Color>
    <Color x:Key="Color.Status.Warning.Bg">#FEF3C7</Color>
    <Color x:Key="Color.Status.Error">#DC2626</Color>
    <Color x:Key="Color.Status.Error.Bg">#FEE2E2</Color>
    <Color x:Key="Color.Status.Info">#2563EB</Color>
    <Color x:Key="Color.Status.Info.Bg">#DBEAFE</Color>

    <!-- Solid Brushes -->
    <SolidColorBrush x:Key="Brush.Primary" Color="{StaticResource Color.Primary}" />
    <SolidColorBrush x:Key="Brush.Primary.Light" Color="{StaticResource Color.Primary.Light}" />
    <SolidColorBrush x:Key="Brush.Primary.Dark" Color="{StaticResource Color.Primary.Dark}" />

    <SolidColorBrush x:Key="Brush.Accent" Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="Brush.Accent.Hover" Color="{StaticResource Color.Accent.Hover}" />
    <SolidColorBrush x:Key="Brush.Accent.Muted" Color="{StaticResource Color.Accent.Muted}" />

    <SolidColorBrush x:Key="Brush.Background" Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="Brush.Surface" Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="Brush.Surface.Muted" Color="{StaticResource Color.Surface.Muted}" />
    <SolidColorBrush x:Key="Brush.Surface.Hover" Color="{StaticResource Color.Surface.Hover}" />

    <SolidColorBrush x:Key="Brush.Text.Primary" Color="{StaticResource Color.Text.Primary}" />
    <SolidColorBrush x:Key="Brush.Text.Secondary" Color="{StaticResource Color.Text.Secondary}" />
    <SolidColorBrush x:Key="Brush.Text.Muted" Color="{StaticResource Color.Text.Muted}" />
    <SolidColorBrush x:Key="Brush.Text.Inverse" Color="{StaticResource Color.Text.Inverse}" />

    <SolidColorBrush x:Key="Brush.Border" Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="Brush.Border.Light" Color="{StaticResource Color.Border.Light}" />
    <SolidColorBrush x:Key="Brush.FocusRing" Color="{StaticResource Color.FocusRing}" />

    <SolidColorBrush x:Key="Brush.Status.Success" Color="{StaticResource Color.Status.Success}" />
    <SolidColorBrush x:Key="Brush.Status.Success.Bg" Color="{StaticResource Color.Status.Success.Bg}" />
    <SolidColorBrush x:Key="Brush.Status.Warning" Color="{StaticResource Color.Status.Warning}" />
    <SolidColorBrush x:Key="Brush.Status.Warning.Bg" Color="{StaticResource Color.Status.Warning.Bg}" />
    <SolidColorBrush x:Key="Brush.Status.Error" Color="{StaticResource Color.Status.Error}" />
    <SolidColorBrush x:Key="Brush.Status.Error.Bg" Color="{StaticResource Color.Status.Error.Bg}" />
    <SolidColorBrush x:Key="Brush.Status.Info" Color="{StaticResource Color.Status.Info}" />
    <SolidColorBrush x:Key="Brush.Status.Info.Bg" Color="{StaticResource Color.Status.Info.Bg}" />

</ResourceDictionary>

