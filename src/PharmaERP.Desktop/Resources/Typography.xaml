<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
                    xmlns:sys="clr-namespace:System;assembly=System.Runtime">

    <!-- Font Family -->
    <FontFamily x:Key="FontFamily.Default">Segoe UI, -apple-system, BlinkMacSystemFont, Roboto, Helvetica Neue, sans-serif</FontFamily>
    <FontFamily x:Key="FontFamily.Monospace">Cascadia Code, Consolas, Courier New, monospace</FontFamily>

    <!-- Font Sizes -->
    <sys:Double x:Key="FontSize.Small">11</sys:Double>
    <sys:Double x:Key="FontSize.Body">13</sys:Double>
    <sys:Double x:Key="FontSize.Subheading">15</sys:Double>
    <sys:Double x:Key="FontSize.Heading">18</sys:Double>
    <sys:Double x:Key="FontSize.Display">22</sys:Double>

    <!-- Text Styles -->
    <Style x:Key="Text.Body" TargetType="TextBlock">
        <Setter Property="FontFamily" Value="{StaticResource FontFamily.Default}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Body}" />
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
    </Style>

    <Style x:Key="Text.Muted" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="Foreground" Value="{StaticResource Brush.Text.Secondary}" />
        <Setter Property="FontSize" Value="{StaticResource FontSize.Small}" />
    </Style>

    <Style x:Key="Text.Subheading" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Subheading}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>

    <Style x:Key="Text.Heading" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Heading}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

    <Style x:Key="Text.Display" TargetType="TextBlock" BasedOn="{StaticResource Text.Body}">
        <Setter Property="FontSize" Value="{StaticResource FontSize.Display}" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>

</ResourceDictionary>

