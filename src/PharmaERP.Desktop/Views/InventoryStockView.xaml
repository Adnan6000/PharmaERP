<UserControl x:Class="PharmaERP.Desktop.Views.InventoryStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:InventoryStockViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <!-- Page Header -->
            <RowDefinition Height="Auto" />
            <!-- Tabs & Content -->
            <RowDefinition Height="*" />
            <!-- Pagination Footer -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. PAGE HEADER -->
        <Grid Grid.Row="0" Margin="0,0,0,16">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0">
                <TextBlock Text="Inventory &amp; Stock Valuation"
                           Style="{StaticResource Text.Display}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Live stock balances, batch expiry tracker, moving weighted-average costs, and audit ledger."
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontSize="13" />
            </StackPanel>

            <Button Grid.Column="1"
                    Style="{StaticResource Button.Outline}"
                    Command="{Binding RefreshCommand}"
                    Padding="12,7"
                    VerticalAlignment="Center">
                <StackPanel Orientation="Horizontal">
                    <TextBlock Text="🔄" Margin="0,0,6,0" />
                    <TextBlock Text="Refresh (F5)" />
                </StackPanel>
            </Button>
        </Grid>

        <!-- 2. TABBED CONTENT -->
        <TabControl Grid.Row="1"
                    SelectedIndex="{Binding SelectedTabIndex}"
                    Background="Transparent"
                    BorderThickness="0">
            <!-- TAB 1: CURRENT STOCK BY PRODUCT -->
            <TabItem Header="📦 Current Stock by Product">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding CurrentStockSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="28,6,8,6"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="🔍"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Current Stock Grid -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding CurrentStockItems}"
                                  BorderThickness="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product Code" Binding="{Binding ProductCode}" Width="110" />
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Manufacturer" Binding="{Binding ManufacturerName}" Width="160" />
                                <DataGridTextColumn Header="Category" Binding="{Binding CategoryName}" Width="140" />
                                <DataGridTextColumn Header="Total Qty On Hand" Binding="{Binding TotalQuantity, StringFormat={}{0:N2}}" Width="140" FontWeight="Bold" />
                                <DataGridTextColumn Header="Estimated Value" Binding="{Binding EstimatedInventoryValue, Converter={StaticResource Money}}" Width="150" Foreground="{StaticResource Brush.Primary}" FontWeight="SemiBold" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 2: BATCH INVENTORY -->
            <TabItem Header="🏷️ Batch Inventory">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Search Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="320" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid Grid.Column="0">
                                <TextBox Text="{Binding BatchStockSearch, UpdateSourceTrigger=PropertyChanged}"
                                         Padding="28,6,8,6"
                                         VerticalContentAlignment="Center" />
                                <TextBlock Text="🔍"
                                           Foreground="{StaticResource Brush.Text.Muted}"
                                           VerticalAlignment="Center"
                                           Margin="8,0,0,0"
                                           IsHitTestVisible="False" />
                            </Grid>
                        </Grid>
                    </Border>

                    <!-- Batch Stock Grid -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding BatchStockItems}"
                                  BorderThickness="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Batch Number" Binding="{Binding BatchNumber}" Width="130" />
                                <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                                <DataGridTextColumn Header="Qty On Hand" Binding="{Binding QuantityOnHand, StringFormat={}{0:N2}}" Width="120" FontWeight="Bold" />
                                <DataGridTextColumn Header="Avg Purchase Cost" Binding="{Binding AveragePurchaseCost, Converter={StaticResource Money}}" Width="140" />
                                <DataGridTextColumn Header="Inventory Value" Binding="{Binding InventoryValue, Converter={StaticResource Money}}" Width="140" FontWeight="SemiBold" />
                                <DataGridTemplateColumn Header="Status" Width="110">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <Border CornerRadius="4" Padding="6,2" HorizontalAlignment="Left">
                                                <Border.Style>
                                                    <Style TargetType="Border">
                                                        <Setter Property="Background" Value="#E6F4EA" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Near Expiry">
                                                                <Setter Property="Background" Value="#FEF3C7" />
                                                            </DataTrigger>
                                                            <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                <Setter Property="Background" Value="#FDE8E8" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Border.Style>
                                                <TextBlock Text="{Binding Status}" FontSize="11" FontWeight="Medium">
                                                    <TextBlock.Style>
                                                        <Style TargetType="TextBlock">
                                                            <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" />
                                                            <Style.Triggers>
                                                                <DataTrigger Binding="{Binding Status}" Value="Near Expiry">
                                                                    <Setter Property="Foreground" Value="#D97706" />
                                                                </DataTrigger>
                                                                <DataTrigger Binding="{Binding Status}" Value="Expired">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Status.Error}" />
                                                                </DataTrigger>
                                                            </Style.Triggers>
                                                        </Style>
                                                    </TextBlock.Style>
                                                </TextBlock>
                                            </Border>
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 3: EXPIRY MONITORING -->
            <TabItem Header="⚠️ Expiry Monitoring">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <!-- Filter Toolbar -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="14,10"
                            Margin="0,0,0,12">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <TextBlock Text="Filter:" VerticalAlignment="Center" Margin="0,0,8,0" FontWeight="SemiBold" />
                            <ComboBox SelectedValue="{Binding SelectedExpiryFilter}"
                                      SelectedValuePath="Tag"
                                      Width="160"
                                      Margin="0,0,20,0"
                                      VerticalContentAlignment="Center">
                                <ComboBoxItem Content="All Stock Batches" Tag="All" IsSelected="True" />
                                <ComboBoxItem Content="Near Expiry (≤90 Days)" Tag="Near Expiry" />
                                <ComboBoxItem Content="Expired Stock" Tag="Expired" />
                                <ComboBoxItem Content="Active Stock" Tag="Active" />
                            </ComboBox>

                            <TextBlock Text="Warning Threshold (Days):" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <TextBox Text="{Binding ExpiryThresholdDays, UpdateSourceTrigger=PropertyChanged}"
                                     Width="60"
                                     VerticalContentAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Expiry Grid -->
                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding ExpiryItems}"
                                  BorderThickness="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="130" />
                                <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                                <DataGridTextColumn Header="Days Until Expiry" Binding="{Binding DaysUntilExpiry}" Width="130" FontWeight="Bold" />
                                <DataGridTextColumn Header="Qty On Hand" Binding="{Binding QuantityOnHand, StringFormat={}{0:N2}}" Width="120" />
                                <DataGridTextColumn Header="Valuation" Binding="{Binding InventoryValue, Converter={StaticResource Money}}" Width="130" />
                                <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="120" FontWeight="SemiBold" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- TAB 4: STOCK MOVEMENTS / LEDGER -->
            <TabItem Header="📜 Audit Movement Ledger">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Surface}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6">
                        <DataGrid ItemsSource="{Binding MovementItems}"
                                  BorderThickness="0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  SelectionMode="Single">
                            <DataGrid.Columns>
                                <DataGridTextColumn Header="Timestamp (UTC)" Binding="{Binding TransactionDateUtc, StringFormat={}{0:yyyy-MM-dd HH:mm}}" Width="140" />
                                <DataGridTextColumn Header="Type" Binding="{Binding MovementType}" Width="130" FontWeight="SemiBold" />
                                <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                                <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="110" />
                                <DataGridTextColumn Header="Qty Delta" Binding="{Binding QuantityDelta, StringFormat={}{0:+0.00;-0.00;0.00}}" Width="100" FontWeight="Bold" />
                                <DataGridTextColumn Header="Balance After" Binding="{Binding BalanceAfter, StringFormat={}{0:N2}}" Width="110" />
                                <DataGridTextColumn Header="Unit Rate" Binding="{Binding UnitCost, Converter={StaticResource Money}}" Width="100" />
                                <DataGridTextColumn Header="Value After" Binding="{Binding InventoryValueAfter, Converter={StaticResource Money}}" Width="120" />
                                <DataGridTextColumn Header="Ref Doc" Binding="{Binding ReferenceDocumentNumber}" Width="130" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>

        <!-- 3. PAGINATION FOOTER -->
        <Grid Grid.Row="2" Margin="0,12,0,0">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                <TextBlock Text="Page Info: " Foreground="{StaticResource Brush.Text.Muted}" FontSize="12" />
                <TextBlock Text="{Binding CurrentStockPageInfo}"
                           Visibility="{Binding SelectedTabIndex, Converter={StaticResource BoolToVis}}"
                           Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" />
            </StackPanel>

            <StackPanel Grid.Column="1" Orientation="Horizontal">
                <Button Style="{StaticResource Button.Outline}"
                        Content="⏮ First"
                        Command="{Binding FirstPageCommand}"
                        Padding="8,4"
                        FontSize="11"
                        Margin="0,0,4,0" />
                <Button Style="{StaticResource Button.Outline}"
                        Content="◀ Prev"
                        Command="{Binding PreviousPageCommand}"
                        Padding="8,4"
                        FontSize="11"
                        Margin="0,0,4,0" />
                <Button Style="{StaticResource Button.Outline}"
                        Content="Next ▶"
                        Command="{Binding NextPageCommand}"
                        Padding="8,4"
                        FontSize="11"
                        Margin="0,0,4,0" />
                <Button Style="{StaticResource Button.Outline}"
                        Content="Last ⏭"
                        Command="{Binding LastPageCommand}"
                        Padding="8,4"
                        FontSize="11" />
            </StackPanel>
        </Grid>
    </Grid>
</UserControl>

