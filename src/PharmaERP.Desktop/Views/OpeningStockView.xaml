<UserControl x:Class="PharmaERP.Desktop.Views.OpeningStockView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             xmlns:common="clr-namespace:PharmaERP.Desktop.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:OpeningStockViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Page Header -->
        <Grid Grid.Row="0" Margin="0,0,0,20">
            <StackPanel>
                <TextBlock Text="Opening Stock Entry"
                           Style="{StaticResource Text.Display}"
                           Margin="0,0,0,4" />
                <TextBlock Text="Initial setup of on-hand inventory balances, batch expiry dates, and unit costs."
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontSize="13" />
            </StackPanel>
        </Grid>

        <!-- Card Container -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="8"
                Padding="24"
                MaxWidth="700"
                HorizontalAlignment="Left"
                VerticalAlignment="Top">
            <StackPanel>
                <!-- Product Selector -->
                <TextBlock Text="Select Product *" FontWeight="SemiBold" Margin="0,0,0,4" />
                <ComboBox ItemsSource="{Binding Products}"
                          SelectedItem="{Binding SelectedProduct}"
                          DisplayMemberPath="Name"
                          common:ClearableHelper.IsClearable="True"
                          common:PlaceholderHelper.Placeholder="Choose a product..."
                          Margin="0,0,0,16"
                          Height="36"
                          VerticalContentAlignment="Center" />

                <!-- Batch Number & Expiry Date -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Batch Number *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding BatchNumber, UpdateSourceTrigger=PropertyChanged}"
                                 common:PlaceholderHelper.Placeholder="e.g. BATCH-2026-A"
                                 Height="34" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Expiry Date *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <DatePicker SelectedDate="{Binding ExpiryDate}" Height="34" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Quantity & Unit Cost -->
                <Grid Margin="0,0,0,16">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Quantity On Hand *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 common:PlaceholderHelper.Placeholder="0.00"
                                 Height="34" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Unit Purchase Cost *" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding UnitCost, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 common:PlaceholderHelper.Placeholder="0.00"
                                 Height="34" VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>

                <!-- Suggested Retail Sale Price -->
                <Grid Margin="0,0,0,20">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="16" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0">
                        <TextBlock Text="Suggested Retail Price (Optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox Text="{Binding SuggestedSalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                                 common:PlaceholderHelper.Placeholder="0.00"
                                 Height="34" VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2">
                        <TextBlock Text="Calculated Inventory Valuation" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <Border Background="{StaticResource Brush.Surface.Muted}" CornerRadius="4" Height="34" Padding="10,0">
                            <TextBlock Text="{Binding TotalValuation, Converter={StaticResource Money}}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{StaticResource Brush.Primary}"
                                       VerticalAlignment="Center" />
                        </Border>
                    </StackPanel>
                </Grid>

                <!-- Feedback Message -->
                <Border CornerRadius="4"
                        Padding="12,10"
                        Margin="0,0,0,16"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E6F4EA" />
                            <Setter Property="BorderBrush" Value="#34A853" />
                            <Setter Property="BorderThickness" Value="1" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                    <Setter Property="Background" Value="#FDE8E8" />
                                    <Setter Property="BorderBrush" Value="#F98080" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}"
                               FontWeight="Medium"
                               FontSize="12">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#137333" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                        <Setter Property="Foreground" Value="#9B1C1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Actions -->
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Style="{StaticResource Button.Outline}"
                            Content="Reset Form"
                            Command="{Binding ResetCommand}"
                            Margin="0,0,12,0"
                            Padding="16,8" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="Save Opening Stock"
                            Command="{Binding SaveCommand}"
                            Padding="20,8" />
                </StackPanel>
            </StackPanel>
        </Border>
    </Grid>
</UserControl>

