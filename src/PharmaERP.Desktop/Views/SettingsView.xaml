<UserControl x:Class="PharmaERP.Desktop.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SettingsViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanConverter x:Key="InverseBool" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="900" HorizontalAlignment="Left">

            <!-- PAGE HEADER -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Database &amp; Network Configuration"
                               Style="{StaticResource Text.Display}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Manage SQL Server profiles, verify office LAN connectivity, and apply database migrations."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- 1. ACTIVE RUNTIME CONNECTION CARD -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Active Database State"
                                   Style="{StaticResource Text.Subheading}"
                                   VerticalAlignment="Center" />

                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                            <Button Style="{StaticResource Button.Outline}"
                                    Content="Database Setup Wizard"
                                    Command="{Binding OpenSetupWizardCommand}"
                                    Padding="12,6"
                                    FontSize="12"
                                    Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Outline}"
                                    Content="Test Active Connection"
                                    Command="{Binding TestActiveConnectionCommand}"
                                    Padding="12,6"
                                    FontSize="12" />
                        </StackPanel>
                    </Grid>

                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                            <RowDefinition Height="30" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Active Profile:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionStore.ActiveProfile}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Connection Status:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionStore.StatusText}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" FontSize="13" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Roundtrip Latency:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectionStore.LatencyText}" FontSize="12" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="3" Grid.Column="0" Text="Schema Initialized:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectionStore.IsDatabaseInitialized, Converter={x:Null}}" FontSize="12" VerticalAlignment="Center">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Text" Value="Yes — Applied EF Core migrations detected" />
                                    <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ConnectionStore.IsDatabaseInitialized}" Value="False">
                                            <Setter Property="Text" Value="No — Pending schema migrations. Click 'Initialize Database' below." />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </Grid>

                    <!-- Error Alert -->
                    <Border Background="{StaticResource Brush.Status.Error.Bg}"
                            BorderBrush="{StaticResource Brush.Status.Error}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,14,0,0"
                            Visibility="{Binding ConnectionStore.ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ConnectionStore.ErrorMessage}"
                                   Foreground="{StaticResource Brush.Status.Error}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. PROFILE CONFIGURATION & SWITCHING CARD -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Workstation Profile Selection"
                               Style="{StaticResource Text.Subheading}"
                               Margin="0,0,0,12" />

                    <TextBlock Text="Select the profile for this workstation. For single-PC standalone installations, select 'Local'. For multiple PCs connecting across an office LAN, select 'LAN'."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="12"
                               Margin="0,0,0,16"
                               TextWrapping="Wrap" />

                    <!-- Profile Dropdown -->
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="150" />
                            <ColumnDefinition Width="300" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0" Text="Select Profile:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" />
                        <ComboBox Grid.Column="1"
                                  ItemsSource="{Binding Profiles}"
                                  SelectedItem="{Binding SelectedProfile}"
                                  VerticalContentAlignment="Center" />
                    </Grid>

                    <!-- Profile Details Box -->
                    <Border Background="{StaticResource Brush.Surface.Muted}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="16"
                            Margin="0,0,0,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="140" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="26" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Description:" Style="{StaticResource Form.Label}" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ProfileDescription}" FontSize="12" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Server:" Style="{StaticResource Form.Label}" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ProfileServer}" FontSize="12" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Database:" Style="{StaticResource Form.Label}" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ProfileDatabase}" FontSize="12" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Connection String:" Style="{StaticResource Form.Label}" Margin="0,4,0,0" />
                            <TextBox Grid.Row="3" Grid.Column="1"
                                     Text="{Binding ProfileConnectionString, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Background="Transparent"
                                     BorderThickness="0"
                                     FontSize="11"
                                     Foreground="{StaticResource Brush.Text.Secondary}"
                                     Margin="0,4,0,0"
                                     TextWrapping="Wrap" />
                        </Grid>
                    </Border>

                    <!-- Profile Actions -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Test Selected Profile"
                                Command="{Binding TestSelectedProfileCommand}"
                                Padding="14,8"
                                Margin="0,0,12,0" />

                        <Button Style="{StaticResource Button.Primary}"
                                Content="Save Profile as Active"
                                Command="{Binding ApplyProfileCommand}"
                                Padding="16,8" />
                    </StackPanel>

                    <!-- Test Result Box -->
                    <Border Background="{StaticResource Brush.Surface.Muted}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,10"
                            Visibility="{Binding ProfileTestResultText, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ProfileTestResultText}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>

                    <!-- Save Result Box -->
                    <Border Background="{StaticResource Brush.Status.Info.Bg}"
                            BorderBrush="{StaticResource Brush.Status.Info}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Visibility="{Binding SaveMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding SaveMessage}"
                                   Foreground="{StaticResource Brush.Status.Info}"
                                   FontSize="12"
                                   TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 3. COMPANY BASE CURRENCY & REGIONAL SETTINGS CARD -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <TextBlock Grid.Column="0"
                                   Text="Company Base Currency &amp; Regional Settings"
                                   Style="{StaticResource Text.Subheading}"
                                   VerticalAlignment="Center" />

                        <!-- Lock Badge -->
                        <Border Grid.Column="1"
                                CornerRadius="4"
                                Padding="10,4"
                                Background="{StaticResource Brush.Surface.Muted}">
                            <TextBlock FontSize="11" FontWeight="Bold">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Setter Property="Text" Value="🔒 BASE CURRENCY LOCKED" />
                                        <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsBaseCurrencyLocked}" Value="False">
                                                <Setter Property="Text" Value="🔓 CONFIGURABLE (Pre-Transaction Stage)" />
                                                <Setter Property="Foreground" Value="{StaticResource Brush.Status.Warning}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Border>
                    </Grid>

                    <TextBlock Text="Authoritative company accounting configuration. Once financial transactions are posted in the ledger, the base currency is locked to preserve double-entry audit integrity."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="12"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <!-- Lock explanation if locked -->
                    <Border Background="{StaticResource Brush.Surface.Muted}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,16"
                            Visibility="{Binding IsBaseCurrencyLocked, Converter={StaticResource BoolToVis}}">
                        <TextBlock Text="ℹ Posted general ledger journal entries exist in this database. Base currency is permanently locked to protect accounting history."
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Text.Secondary}" />
                    </Border>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="360" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <!-- Base Currency Selector -->
                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Company Base Currency:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,0,12" />
                        <ComboBox Grid.Row="0" Grid.Column="1"
                                  ItemsSource="{Binding CuratedCurrencies}"
                                  SelectedItem="{Binding SelectedCurrency}"
                                  IsEnabled="{Binding IsBaseCurrencyLocked, Converter={StaticResource InverseBool}}"
                                  Height="34"
                                  Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock FontWeight="SemiBold">
                                        <Run Text="{Binding CurrencyCode, Mode=OneWay}" />
                                        <Run Text=" — " />
                                        <Run Text="{Binding CurrencyName, Mode=OneWay}" FontWeight="Normal" />
                                        <Run Text="{Binding Symbol, StringFormat=' ({0})', Mode=OneWay}" FontWeight="Bold" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>

                        <!-- Currency Live Preview -->
                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Monetary Display Preview:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,0,12" />
                        <Border Grid.Row="1" Grid.Column="1"
                                Background="{StaticResource Brush.Surface.Muted}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10,6"
                                Margin="0,0,0,12">
                            <TextBlock Text="{Binding SampleAmountFormatted}"
                                       FontWeight="Bold"
                                       FontSize="14"
                                       Foreground="{StaticResource Brush.Primary}" />
                        </Border>

                        <!-- Workstation Language -->
                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Workstation Language:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,0,0,12" />
                        <ComboBox Grid.Row="2" Grid.Column="1"
                                  ItemsSource="{Binding SupportedLanguages}"
                                  SelectedItem="{Binding SelectedLanguage}"
                                  Height="34"
                                  Margin="0,0,0,12">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <TextBlock>
                                        <Run Text="{Binding NativeName, Mode=OneWay}" FontWeight="Bold" />
                                        <Run Text="{Binding EnglishName, StringFormat=' ({0})', Mode=OneWay}" Foreground="{StaticResource Brush.Text.Secondary}" />
                                    </TextBlock>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                    </Grid>

                    <Button Style="{StaticResource Button.Primary}"
                            Content="Save Regional &amp; Language Settings"
                            Command="{Binding SaveRegionalSettingsCommand}"
                            Padding="16,8"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,10" />

                    <!-- Regional Save Feedback -->
                    <Border Background="{StaticResource Brush.Status.Success.Bg}"
                            BorderBrush="{StaticResource Brush.Status.Success}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="10"
                            Margin="0,4,0,0"
                            Visibility="{Binding RegionalSaveMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding RegionalSaveMessage}"
                                   Foreground="{StaticResource Brush.Status.Success}"
                                   FontSize="12" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 4. DATABASE SCHEMA INITIALIZATION / UPGRADE CARD -->
            <Border Style="{StaticResource Card.Default}">
                <StackPanel>
                    <TextBlock Text="Database Schema Migration &amp; Upgrade"
                               Style="{StaticResource Text.Subheading}"
                               Margin="0,0,0,8" />

                    <TextBlock Text="Executes official Entity Framework Core migrations against the active database server. Ensures all tables, unique indexes, constraints, and decimal precision configurations are properly deployed."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="12"
                               LineHeight="18"
                               TextWrapping="Wrap"
                               Margin="0,0,0,16" />

                    <Button Style="{StaticResource Button.Primary}"
                            Content="Initialize / Upgrade Database"
                            Command="{Binding MigrateDatabaseCommand}"
                            Padding="18,10"
                            HorizontalAlignment="Left"
                            Margin="0,0,0,14" />

                    <!-- Migration Status Box -->
                    <Border Background="{StaticResource Brush.Surface.Muted}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="5"
                            Padding="12"
                            Margin="0,0,0,10"
                            Visibility="{Binding MigrationStatusMessage, Converter={StaticResource NullToVis}}">
                        <StackPanel>
                            <TextBlock Text="{Binding MigrationStatusMessage}"
                                       FontWeight="SemiBold"
                                       FontSize="12" />
                            <TextBox Text="{Binding MigrationTechnicalDetails, Mode=OneWay}"
                                     IsReadOnly="True"
                                     Margin="0,8,0,0"
                                     Height="80"
                                     VerticalScrollBarVisibility="Auto"
                                     FontSize="11"
                                     Foreground="{StaticResource Brush.Text.Secondary}"
                                     Visibility="{Binding MigrationTechnicalDetails, Converter={StaticResource NullToVis}}" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </Border>

        </StackPanel>
    </ScrollViewer>
</UserControl>

