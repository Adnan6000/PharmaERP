<UserControl x:Class="PharmaERP.Desktop.Views.PurchaseReturnsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseReturnsViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- MAIN WORKSPACE -->
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Search Toolbar -->
                <RowDefinition Height="Auto" />
                <!-- Returns Table -->
                <RowDefinition Height="*" />
                <!-- Pagination Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. PAGE HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Purchase Returns (Debit Notes)"
                               Style="{StaticResource Text.Display}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Return defective, damaged, or near-expiry stock to vendors with atomic stock adjustment."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Outline}"
                            Command="{Binding RefreshCommand}"
                            Padding="12,7"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh (F5)" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding OpenCreateDrawerCommand}"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" />
                            <TextBlock Text="New Purchase Return" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. SEARCH & FILTER TOOLBAR -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 Padding="28,6,8,6"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="🔍"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Suppliers}"
                              SelectedItem="{Binding SelectedSupplierFilter}"
                              DisplayMemberPath="Name"
                              VerticalContentAlignment="Center" />
                </Grid>
            </Border>

            <!-- 3. RETURNS DATAGRID -->
            <Border Grid.Row="2"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <DataGrid ItemsSource="{Binding Returns}"
                              SelectedItem="{Binding SelectedReturn}"
                              BorderThickness="0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              SelectionMode="Single">
                        <DataGrid.Columns>
                            <DataGridTextColumn Header="Return #" Binding="{Binding ReturnNumber}" Width="150" FontWeight="Bold" />
                            <DataGridTextColumn Header="Original Inv #" Binding="{Binding OriginalPurchaseInvoiceNumber}" Width="150" />
                            <DataGridTextColumn Header="Supplier Name" Binding="{Binding SupplierName}" Width="*" />
                            <DataGridTextColumn Header="Return Date" Binding="{Binding ReturnDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                            <DataGridTextColumn Header="Items" Binding="{Binding ItemCount}" Width="70" />
                            <DataGridTextColumn Header="Total Amount" Binding="{Binding TotalAmount, Converter={StaticResource CurrencyConverter}}" Width="130" FontWeight="SemiBold" Foreground="{StaticResource Brush.Primary}" />
                            <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />

                            <DataGridTemplateColumn Header="Actions" Width="140">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Button.Subtle}"
                                                    Content="View"
                                                    Command="{Binding DataContext.ViewDetailsCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2"
                                                    Margin="0,0,4,0" />
                                            <Button Content="Cancel"
                                                    Foreground="#C81E1E"
                                                    Command="{Binding DataContext.OpenCancelDialogCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Padding="6,2">
                                                <Button.Style>
                                                    <Style TargetType="Button" BasedOn="{StaticResource Button.Subtle}">
                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding Status}" Value="Posted">
                                                                <Setter Property="Visibility" Value="Visible" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Button.Style>
                                            </Button>
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading Overlay -->
                    <Border Background="#80FFFFFF"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Loading returns..."
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. PAGINATION FOOTER -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding PageInfoText}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Outline}"
                            Content="⏮ First"
                            Command="{Binding FirstPageCommand}"
                            Padding="8,4"
                            FontSize="11"
                            Margin="0,0,4,0" />
                    <Button Style="{StaticResource Button.Outline}"
                            Content="◀ Prev"
                            Command="{Binding PreviousPageCommand}"
                            Padding="8,4"
                            FontSize="11"
                            Margin="0,0,4,0" />
                    <Button Style="{StaticResource Button.Outline}"
                            Content="Next ▶"
                            Command="{Binding NextPageCommand}"
                            Padding="8,4"
                            FontSize="11"
                            Margin="0,0,4,0" />
                    <Button Style="{StaticResource Button.Outline}"
                            Content="Last ⏭"
                            Command="{Binding LastPageCommand}"
                            Padding="8,4"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- CREATE RETURN DRAWER -->
        <Grid Visibility="{Binding IsCreateDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />

            <Border HorizontalAlignment="Right"
                    Width="650"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="Create Purchase Return" FontSize="16" FontWeight="Bold" VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Subtle}"
                                    Content="✕"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseCreateDrawerCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="20,16">
                        <StackPanel>
                            <!-- Supplier -->
                            <TextBlock Text="Supplier *" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding Suppliers}"
                                      SelectedItem="{Binding FormSupplier}"
                                      DisplayMemberPath="Name"
                                      Height="32"
                                      Margin="0,0,0,14"
                                      VerticalContentAlignment="Center" />

                            <!-- Original Invoice Selection -->
                            <TextBlock Text="Link to Original Purchase Invoice (Optional)" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <ComboBox ItemsSource="{Binding SupplierInvoices}"
                                      SelectedItem="{Binding FormOriginalInvoice}"
                                      DisplayMemberPath="InvoiceNumber"
                                      Height="32"
                                      Margin="0,0,0,14"
                                      VerticalContentAlignment="Center" />

                            <!-- Reason -->
                            <TextBlock Text="Return Reason" FontWeight="SemiBold" Margin="0,0,0,4" />
                            <TextBox Text="{Binding FormReason, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     Margin="0,0,0,14"
                                     VerticalContentAlignment="Center" />

                            <!-- Return Items Grid -->
                            <TextBlock Text="Items to Return" FontWeight="Bold" FontSize="13" Margin="0,0,0,6" />
                            <TextBlock Text="Enter return quantity for eligible line items below:" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" Margin="0,0,0,8" />

                            <DataGrid ItemsSource="{Binding ReturnItems}"
                                      AutoGenerateColumns="False"
                                      CanUserAddRows="False"
                                      BorderThickness="1"
                                      BorderBrush="{StaticResource Brush.Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="100" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Max Qty" Binding="{Binding MaxReturnableQuantity, StringFormat={}{0:N2}}" Width="70" IsReadOnly="True" Foreground="{StaticResource Brush.Text.Muted}" />
                                    <DataGridTextColumn Header="Return Qty" Binding="{Binding Quantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}" Width="90" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Return Rate" Binding="{Binding ReturnRate, Converter={StaticResource CurrencyConverter}}" Width="90" IsReadOnly="True" />
                                    <DataGridTextColumn Header="Total" Binding="{Binding LineTotal, Converter={StaticResource CurrencyConverter}}" Width="90" IsReadOnly="True" FontWeight="SemiBold" />
                                </DataGrid.Columns>
                            </DataGrid>

                            <!-- Return Total -->
                            <Border Background="{StaticResource Brush.Surface.Muted}" CornerRadius="6" Padding="12" Margin="0,14,0,0">
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="Total Debit Note Amount: "
                                               FontWeight="Bold"
                                               FontSize="15"
                                               Foreground="{StaticResource Brush.Primary}" />
                                    <TextBlock Text="{Binding FormTotalAmount, Converter={StaticResource CurrencyConverter}}"
                                               FontWeight="Bold"
                                               FontSize="15"
                                               Foreground="{StaticResource Brush.Primary}" />
                                </StackPanel>
                            </Border>

                            <Border Background="#FDE8E8"
                                    BorderBrush="#F98080"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,12,0,0"
                                    Visibility="{Binding FormErrorMessage, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding FormErrorMessage}" Foreground="#9B1C1C" TextWrapping="Wrap" FontSize="12" />
                            </Border>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="20,14" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Outline}"
                                    Content="Cancel"
                                    Command="{Binding CloseCreateDrawerCommand}"
                                    Margin="0,0,10,0"
                                    Padding="14,6" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Content="Post Purchase Return"
                                    Command="{Binding SaveReturnCommand}"
                                    Padding="16,6" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- DETAILS DRAWER -->
        <Grid Visibility="{Binding IsDetailsDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" MouseDown="OnScrimMouseDown" />

            <Border HorizontalAlignment="Right"
                    Width="600"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <Border Grid.Row="0" Padding="20,16" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
                        <Grid>
                            <TextBlock Text="{Binding SelectedReturnDetails.ReturnNumber, StringFormat='Return Details — {0}'}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       VerticalAlignment="Center" />
                            <Button Style="{StaticResource Button.Subtle}"
                                    Content="✕"
                                    HorizontalAlignment="Right"
                                    Command="{Binding CloseDetailsCommand}" />
                        </Grid>
                    </Border>

                    <ScrollViewer Grid.Row="1" Padding="20,16">
                        <StackPanel>
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Supplier:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" />
                                    <TextBlock Text="{Binding SelectedReturnDetails.SupplierName}" FontWeight="Bold" FontSize="14" Margin="0,2,0,8" />

                                    <TextBlock Text="Return Date:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" />
                                    <TextBlock Text="{Binding SelectedReturnDetails.ReturnDate, StringFormat={}{0:yyyy-MM-dd}}" FontSize="13" />
                                </StackPanel>
                                <StackPanel Grid.Column="1">
                                    <TextBlock Text="Original Invoice:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" />
                                    <TextBlock Text="{Binding SelectedReturnDetails.OriginalPurchaseInvoiceNumber}" FontWeight="SemiBold" FontSize="13" Margin="0,2,0,8" />

                                    <TextBlock Text="Total Amount:" FontWeight="SemiBold" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" />
                                    <TextBlock Text="{Binding SelectedReturnDetails.TotalAmount, Converter={StaticResource Money}}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource Brush.Primary}" />
                                </StackPanel>
                            </Grid>

                            <TextBlock Text="Returned Items" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                            <DataGrid ItemsSource="{Binding SelectedReturnDetails.Items}"
                                      AutoGenerateColumns="False"
                                      IsReadOnly="True"
                                      BorderThickness="1"
                                      BorderBrush="{StaticResource Brush.Border}">
                                <DataGrid.Columns>
                                    <DataGridTextColumn Header="Product" Binding="{Binding ProductName}" Width="*" />
                                    <DataGridTextColumn Header="Batch" Binding="{Binding BatchNumber}" Width="110" />
                                    <DataGridTextColumn Header="Qty Returned" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="90" FontWeight="Bold" />
                                    <DataGridTextColumn Header="Return Rate" Binding="{Binding ReturnRate, Converter={StaticResource Money}}" Width="90" />
                                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, Converter={StaticResource Money}}" Width="100" FontWeight="SemiBold" />
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </ScrollViewer>

                    <Border Grid.Row="2" Padding="20,14" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Close"
                                Command="{Binding CloseDetailsCommand}"
                                HorizontalAlignment="Right"
                                Padding="16,6" />
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <!-- CANCEL RETURN MODAL -->
        <Grid Visibility="{Binding IsCancelDrawerOpen, Converter={StaticResource BoolToVis}}">
            <Border Background="#66000000" />
            <Border HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Width="460"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Padding="24">
                <StackPanel>
                    <TextBlock Text="Cancel Purchase Return" FontSize="16" FontWeight="Bold" Margin="0,0,0,8" />
                    <TextBlock Text="Cancelling this purchase return will restore returned stock back into batch inventory, reverse invoice return quantities, and append a compensating ledger entry. This cannot be undone."
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="13"
                               Margin="0,0,0,16" />

                    <TextBlock Text="Reason for Cancellation *" FontWeight="SemiBold" Margin="0,0,0,4" />
                    <TextBox Text="{Binding CancelReason, UpdateSourceTrigger=PropertyChanged}"
                             Height="60"
                             TextWrapping="Wrap"
                             AcceptsReturn="True"
                             VerticalScrollBarVisibility="Auto"
                             Margin="0,0,0,12" />

                    <Border Background="#FDF2F2"
                            BorderBrush="#F98080"
                            BorderThickness="1"
                            CornerRadius="4"
                            Padding="10,6"
                            Margin="0,0,0,12"
                            Visibility="{Binding CancelErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding CancelErrorMessage}" Foreground="#9B1C1C" TextWrapping="Wrap" FontSize="12" />
                    </Border>

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Back"
                                Command="{Binding CloseCancelCommand}"
                                Padding="14,6"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Primary}"
                                Content="Confirm Cancellation"
                                Background="#C81E1E"
                                BorderBrush="#9B1C1C"
                                Command="{Binding ConfirmCancelCommand}"
                                Padding="14,6" />
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>

