<UserControl x:Class="PharmaERP.Desktop.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:DashboardViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="1050" HorizontalAlignment="Left">

            <!-- PAGE HEADER -->
            <Grid Margin="0,0,0,24">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Operations Dashboard"
                               Style="{StaticResource Text.Display}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Live inventory metrics, master record counts, and database health."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Outline}"
                            Command="{Binding RefreshCommand}"
                            Padding="12,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh (F5)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- OFFLINE / DISCONNECTED WARNING BANNER -->
            <Border Background="{StaticResource Brush.Status.Warning.Bg}"
                    BorderBrush="{StaticResource Brush.Status.Warning}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="16,14"
                    Margin="0,0,0,20"
                    Visibility="{Binding ConnectionStore.IsConnected, Converter={StaticResource InverseBoolToVis}}">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBlock Grid.Column="0"
                               Text="⚠️"
                               FontSize="22"
                               Margin="0,0,14,0"
                               VerticalAlignment="Center" />

                    <StackPanel Grid.Column="1" VerticalAlignment="Center">
                        <TextBlock Text="Database Connectivity Notice"
                                   FontWeight="Bold"
                                   Foreground="{StaticResource Brush.Status.Warning}"
                                   FontSize="13" />
                        <TextBlock Text="{Binding ConnectionStore.ErrorMessage, FallbackValue='Unable to connect to configured SQL Server. Please verify the host PC or connection string.'}"
                                   Foreground="{StaticResource Brush.Text.Primary}"
                                   FontSize="12"
                                   Margin="0,2,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                        <Button Style="{StaticResource Button.Primary}"
                                Content="Database Settings"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Settings"
                                Padding="12,6"
                                FontSize="12"
                                Margin="0,0,8,0" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- ERROR MESSAGE (IF ANY DURING METRICS RETRIEVAL) -->
            <Border Background="{StaticResource Brush.Status.Error.Bg}"
                    BorderBrush="{StaticResource Brush.Status.Error}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,20"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ErrorMessage}"
                           Foreground="{StaticResource Brush.Status.Error}"
                           FontSize="12"
                           TextWrapping="Wrap" />
            </Border>

            <!-- REAL SALES METRICS (Requirement 16) -->
            <TextBlock Text="Today's Sales Performance" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Today's Net Sales -->
                <Border Style="{StaticResource Card.Stat}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="TODAY'S NET SALES" Style="{StaticResource Text.Muted}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TodayNetSales, StringFormat='Rs. {0:N2}'}"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}" Margin="0,6,0,4" />
                        <TextBlock Text="Net revenue after returns" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Today's Invoices -->
                <Border Style="{StaticResource Card.Stat}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="INVOICES ISSUED" Style="{StaticResource Text.Muted}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TodayInvoiceCount, StringFormat='{}{0:N0}'}"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,6,0,4" />
                        <TextBlock Text="Completed sales tickets" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Today's Gross Sales -->
                <Border Style="{StaticResource Card.Stat}" Margin="0,0,12,0">
                    <StackPanel>
                        <TextBlock Text="GROSS SALES" Style="{StaticResource Text.Muted}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TodaySalesTotal, StringFormat='Rs. {0:N2}'}"
                                   FontSize="22" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" Margin="0,6,0,4" />
                        <TextBlock Text="Total billed before returns" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" />
                    </StackPanel>
                </Border>

                <!-- Customer Returns -->
                <Border Style="{StaticResource Card.Stat}">
                    <StackPanel>
                        <TextBlock Text="CUSTOMER RETURNS" Style="{StaticResource Text.Muted}" FontWeight="Bold" />
                        <TextBlock Text="{Binding TodayReturnsTotal, StringFormat='Rs. {0:N2}'}"
                                   FontSize="22" FontWeight="Bold" Foreground="Crimson" Margin="0,6,0,4" />
                        <TextBlock Text="{Binding TodayReturnCount, StringFormat='{}{0} return(s) processed'}" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="11" />
                    </StackPanel>
                </Border>
            </UniformGrid>

            <!-- STAT METRIC CARDS -->
            <TextBlock Text="Catalog &amp; Master Records" FontWeight="Bold" FontSize="14" Margin="0,0,0,10" />
            <UniformGrid Columns="4" Margin="0,0,0,24">
                <!-- Products Card -->
                <Border Style="{StaticResource Card.Stat}" Margin="0,0,12,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="TOTAL PRODUCTS"
                                       Style="{StaticResource Text.Muted}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalProducts, StringFormat='{}{0:N0}'}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Accent}"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="Registered catalog items"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontSize="11" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource Button.Subtle}"
                                Content="Browse Products →"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Products"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0" />
                    </DockPanel>
                </Border>

                <!-- Manufacturers Card -->
                <Border Style="{StaticResource Card.Stat}" Margin="6,0,6,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="MANUFACTURERS"
                                       Style="{StaticResource Text.Muted}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalManufacturers, StringFormat='{}{0:N0}'}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="Suppliers &amp; Brands"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontSize="11" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource Button.Subtle}"
                                Content="Manage Suppliers →"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Manufacturers"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0" />
                    </DockPanel>
                </Border>

                <!-- Categories Card -->
                <Border Style="{StaticResource Card.Stat}" Margin="6,0,6,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="CATEGORIES"
                                       Style="{StaticResource Text.Muted}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalCategories, StringFormat='{}{0:N0}'}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="Dosage &amp; Drug groups"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontSize="11" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource Button.Subtle}"
                                Content="View Categories →"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Categories"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0" />
                    </DockPanel>
                </Border>

                <!-- Units Card -->
                <Border Style="{StaticResource Card.Stat}" Margin="12,0,0,0">
                    <DockPanel LastChildFill="True">
                        <StackPanel DockPanel.Dock="Top">
                            <TextBlock Text="UNITS OF MEASURE"
                                       Style="{StaticResource Text.Muted}"
                                       FontWeight="Bold" />
                            <TextBlock Text="{Binding TotalUnits, StringFormat='{}{0:N0}'}"
                                       FontSize="28"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Margin="0,6,0,4" />
                            <TextBlock Text="Dispensing units"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       FontSize="11" />
                        </StackPanel>
                        <Button DockPanel.Dock="Bottom"
                                Style="{StaticResource Button.Subtle}"
                                Content="Manage Units →"
                                Command="{Binding NavigateToCommand}"
                                CommandParameter="Units"
                                HorizontalAlignment="Left"
                                Margin="0,14,0,0" />
                    </DockPanel>
                </Border>
            </UniformGrid>

            <!-- LOWER INFO PANELS: QUICK ACTIONS & SYSTEM STATUS -->
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <!-- Quick Operations Card -->
                <Border Grid.Column="0" Style="{StaticResource Card.Default}" Margin="0,0,10,0">
                    <StackPanel>
                        <TextBlock Text="Quick Actions"
                                   Style="{StaticResource Text.Subheading}"
                                   Margin="0,0,0,12" />

                        <StackPanel Margin="0,0,0,8">
                            <Button Style="{StaticResource Button.Outline}"
                                    Command="{Binding NavigateToCommand}"
                                    CommandParameter="Products"
                                    HorizontalContentAlignment="Left"
                                    Padding="14,10"
                                    Margin="0,0,0,8">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💊" FontSize="16" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="Manage Products Catalog" FontWeight="SemiBold" />
                                        <TextBlock Text="Search, add, edit, or adjust pricing across product items"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Outline}"
                                    Command="{Binding NavigateToCommand}"
                                    CommandParameter="Settings"
                                    HorizontalContentAlignment="Left"
                                    Padding="14,10">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="16" Margin="0,0,10,0" />
                                    <StackPanel>
                                        <TextBlock Text="Database &amp; Network Configuration" FontWeight="SemiBold" />
                                        <TextBlock Text="Configure LAN workstation profile or apply database migrations"
                                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                                   FontSize="11" />
                                    </StackPanel>
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Database / Connectivity Status Card -->
                <Border Grid.Column="1" Style="{StaticResource Card.Default}" Margin="10,0,0,0">
                    <StackPanel>
                        <TextBlock Text="Database &amp; Workstation Health"
                                   Style="{StaticResource Text.Subheading}"
                                   Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,8">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="130" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                                <RowDefinition Height="28" />
                            </Grid.RowDefinitions>

                            <TextBlock Grid.Row="0" Grid.Column="0" Text="Active Profile:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding ConnectionStore.ActiveProfile}" FontWeight="Bold" Foreground="{StaticResource Brush.Text.Primary}" FontSize="12" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="1" Grid.Column="0" Text="Connection State:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding ConnectionStore.StatusText}" FontWeight="SemiBold" Foreground="{StaticResource Brush.Accent}" FontSize="12" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="2" Grid.Column="0" Text="Roundtrip Latency:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding ConnectionStore.LatencyText}" FontSize="12" VerticalAlignment="Center" />

                            <TextBlock Grid.Row="3" Grid.Column="0" Text="Last Checked:" Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" VerticalAlignment="Center" />
                            <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding ConnectionStore.LastCheckedAt, StringFormat='{}{0:T}'}" FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" />
                        </Grid>
                    </StackPanel>
                </Border>
            </Grid>
        </StackPanel>
    </ScrollViewer>
</UserControl>

