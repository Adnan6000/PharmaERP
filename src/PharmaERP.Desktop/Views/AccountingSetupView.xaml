<UserControl x:Class="PharmaERP.Desktop.Views.AccountingSetupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:AccountingSetupViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,24">
        <StackPanel MaxWidth="960" HorizontalAlignment="Left">

            <!-- PAGE HEADER -->
            <Grid Margin="0,0,0,24">
                <StackPanel>
                    <TextBlock Text="Accounting Setup &amp; Automated Reconciliation" Style="{StaticResource Text.Display}" Margin="0,0,0,4" />
                    <TextBlock Text="Initialize double-entry Chart of Accounts, backfill historical transactions, configure lock dates, and audit subledger reconciliations."
                               Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" />
                </StackPanel>
            </Grid>

            <!-- 1. ACCOUNTING STATE CARD -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,20">
                <StackPanel>
                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0" Text="Accounting Foundation State" Style="{StaticResource Text.Subheading}" VerticalAlignment="Center" />
                        <Button Grid.Column="1" Style="{StaticResource Button.Outline}" Content="🔄 Check State" Command="{Binding RefreshCommand}" Padding="12,6" FontSize="12" />
                    </Grid>

                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="34" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Operational State:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding SetupState}" FontWeight="Bold" FontSize="14" VerticalAlignment="Center" Foreground="{StaticResource Brush.Primary}" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Setup Actions:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,12,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" Margin="0,12,0,0">
                            <Button Style="{StaticResource Button.Primary}"
                                    Content="🚀 Initialize Accounting Foundation &amp; Run Backfill"
                                    Command="{Binding InitializeAccountingCommand}"
                                    Padding="16,8" />
                        </StackPanel>
                    </Grid>

                    <!-- Status Notification Banner -->
                    <Border Background="{StaticResource Brush.Surface.Muted}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,0,0,8" Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource Brush.Text.Primary}" FontSize="12" TextWrapping="Wrap" />
                    </Border>

                    <!-- Error Alert -->
                    <Border Background="{StaticResource Brush.Status.Error.Bg}" BorderBrush="{StaticResource Brush.Status.Error}" BorderThickness="1" CornerRadius="4" Padding="12" Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                        <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Error}" FontSize="12" TextWrapping="Wrap" />
                    </Border>
                </StackPanel>
            </Border>

            <!-- 2. ACCOUNTING LOCK DATE CONTROL -->
            <Border Style="{StaticResource Card.Default}" Margin="0,0,0,20">
                <StackPanel>
                    <TextBlock Text="Accounting Lock Date Enforcement" Style="{StaticResource Text.Subheading}" Margin="0,0,0,6" />
                    <TextBlock Text="Prevent any operational sales, returns, purchases, or voucher changes on or before the selected business date."
                               Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,0,0,16" />

                    <Grid Margin="0,0,0,12">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="32" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Current Lock Date:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" />
                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CurrentLockDate, StringFormat='yyyy-MM-dd', TargetNullValue='None (All fiscal dates open)'}" FontWeight="Bold" FontSize="13" VerticalAlignment="Center" />

                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Set New Lock Date:" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0,10,0,0" />
                        <StackPanel Grid.Row="1" Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,10,0,0">
                            <DatePicker SelectedDate="{Binding NewLockDate}" Width="150" Margin="0,0,12,0" />
                            <Button Style="{StaticResource Button.Primary}" Content="🔒 Set Lock Date" Command="{Binding SetLockDateCommand}" Padding="14,6" Margin="0,0,8,0" />
                            <Button Style="{StaticResource Button.Outline}" Content="🔓 Remove Lock Date" Command="{Binding ClearLockDateCommand}" Padding="14,6" />
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <!-- 3. 4-WAY AUTOMATED RECONCILIATION AUDIT CARD -->
            <Border Style="{StaticResource Card.Default}">
                <StackPanel>
                    <Grid Margin="0,0,0,16">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <StackPanel Grid.Column="0">
                            <TextBlock Text="4-Way Automated Subledger &amp; GL Reconciliation" Style="{StaticResource Text.Subheading}" />
                            <TextBlock Text="Real-time verification of operational inventories and party balances against the authoritative General Ledger."
                                       Foreground="{StaticResource Brush.Text.Secondary}" FontSize="12" Margin="0,2,0,0" />
                        </StackPanel>
                        <Button Grid.Column="1" Style="{StaticResource Button.Primary}" Content="🔍 Audit Reconciliations Now" Command="{Binding RunReconciliationCommand}" Padding="16,6" />
                    </Grid>

                    <!-- Reconciliation Cards Grid -->
                    <UniformGrid Columns="2" Margin="0,0,0,12">
                        <!-- Card 1: Inventory GL vs Stock Valuation -->
                        <Border Background="{StaticResource Brush.Surface.Muted}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,12">
                            <StackPanel>
                                <TextBlock Text="📦 Inventory GL vs Valuation" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <TextBlock FontSize="12"><Run Text="GL Inventory Balance: " /><Run Text="{Binding ReconResult.InventoryGlBalance, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Stock Valuation (FIFO/WAC): " /><Run Text="{Binding ReconResult.PhysicalStockValuation, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"><Run Text="Difference: " /><Run Text="{Binding ReconResult.InventoryDifference, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock Text="{Binding ReconResult.InventoryStatusText, TargetNullValue='Pending Audit'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Brush.Primary}" />
                            </StackPanel>
                        </Border>

                        <!-- Card 2: AR GL vs Customer Subledger -->
                        <Border Background="{StaticResource Brush.Surface.Muted}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,12">
                            <StackPanel>
                                <TextBlock Text="👥 AR GL vs Customer Balances" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <TextBlock FontSize="12"><Run Text="GL AR Balance: " /><Run Text="{Binding ReconResult.ArControlBalance, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Customer Subledger Total: " /><Run Text="{Binding ReconResult.CustomerSubledgersTotal, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"><Run Text="Difference: " /><Run Text="{Binding ReconResult.ArDifference, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock Text="{Binding ReconResult.ArStatusText, TargetNullValue='Pending Audit'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Brush.Primary}" />
                            </StackPanel>
                        </Border>

                        <!-- Card 3: AP GL vs Supplier Subledger -->
                        <Border Background="{StaticResource Brush.Surface.Muted}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="0,0,8,0">
                            <StackPanel>
                                <TextBlock Text="🚚 AP GL vs Supplier Balances" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <TextBlock FontSize="12"><Run Text="GL AP Balance: " /><Run Text="{Binding ReconResult.ApControlBalance, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Supplier Subledger Total: " /><Run Text="{Binding ReconResult.SupplierSubledgersTotal, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"><Run Text="Difference: " /><Run Text="{Binding ReconResult.ApDifference, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock Text="{Binding ReconResult.ApStatusText, TargetNullValue='Pending Audit'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Brush.Primary}" />
                            </StackPanel>
                        </Border>

                        <!-- Card 4: Trial Balance Debit vs Credit -->
                        <Border Background="{StaticResource Brush.Surface.Muted}" BorderBrush="{StaticResource Brush.Border}" BorderThickness="1" CornerRadius="6" Padding="14" Margin="8,0,0,0">
                            <StackPanel>
                                <TextBlock Text="⚖️ General Ledger Double-Entry Equality" FontWeight="Bold" FontSize="13" Margin="0,0,0,8" />
                                <TextBlock FontSize="12"><Run Text="Total Debit: " /><Run Text="{Binding ReconResult.TrialBalanceDebit, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock FontSize="12"><Run Text="Total Credit: " /><Run Text="{Binding ReconResult.TrialBalanceCredit, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock FontSize="12" FontWeight="SemiBold" Margin="0,0,0,6"><Run Text="Difference: " /><Run Text="{Binding ReconResult.TrialBalanceDifference, Mode=OneWay, Converter={StaticResource Money}}" /></TextBlock>
                                <TextBlock Text="{Binding ReconResult.TrialBalanceStatusText, TargetNullValue='Pending Audit'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource Brush.Primary}" />
                            </StackPanel>
                        </Border>
                    </UniformGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>