<UserControl x:Class="PharmaERP.Desktop.Views.SalesEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             xmlns:common="clr-namespace:PharmaERP.Desktop.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SalesEntryViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ClearFormCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F8" Command="{Binding ParkTicketCommand}" />
        <KeyBinding Key="F9" Command="{Binding RecallTicketCommand}" />
        <KeyBinding Key="F10" Command="{Binding OpenTenderModalCommand}" />
        <KeyBinding Key="F12" Command="{Binding QuickCashSaleCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteItemCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <!-- Top Controls (Header & Barcode Search) -->
            <RowDefinition Height="Auto" />
            <!-- Cart Items Grid -->
            <RowDefinition Height="*" />
            <!-- Bottom Controls (Summary & Actions) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP CONTROLS & BARCODE SEARCH -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Title, Mode Toggle, & Action Buttons Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <WrapPanel Grid.Column="0" VerticalAlignment="Center">
                        <TextBlock Text="POS Counter"
                                   Style="{StaticResource Text.Display}"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,4" />
                        <RadioButton Content="Cash Sale"
                                     IsChecked="{Binding IsCashSale, Mode=TwoWay}"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,4" />
                        <RadioButton Content="Credit Sale (Customer Req.)"
                                     IsChecked="{Binding IsCreditSale, Mode=TwoWay}"
                                     FontWeight="SemiBold"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,4" />
                    </WrapPanel>

                    <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Park (F8)"
                                Command="{Binding ParkTicketCommand}"
                                Padding="12,5"
                                Margin="0,0,6,4"
                                FontSize="11" />
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Recall (F9)"
                                Command="{Binding RecallTicketCommand}"
                                Padding="12,5"
                                Margin="0,0,6,4"
                                FontSize="11" />
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Clear / New (Ctrl+N)"
                                Command="{Binding ClearFormCommand}"
                                Padding="12,5"
                                Margin="0,0,0,4"
                                FontSize="11" />
                    </WrapPanel>
                </Grid>

                <!-- Contextual Customer & Reference Strip -->
                <WrapPanel Grid.Row="1" Margin="0,0,0,10" VerticalAlignment="Center">
                    <!-- Cash Sale: Compact Walk-in Indicator with optional customer -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsCashSale, Converter={StaticResource BoolToVis}}"
                                Margin="0,2,16,2">
                        <Border Background="{StaticResource Brush.Surface.Muted}"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,10,0">
                            <TextBlock Text="Walk-in Cash Sale"
                                       FontSize="12"
                                       FontWeight="Medium"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                        </Border>
                        <TextBlock Text="Customer (Opt):"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <ComboBox Width="180"
                                  ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  common:PlaceholderHelper.Placeholder="Select Customer (Opt)..."
                                  VerticalContentAlignment="Center"
                                  VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Credit Sale: Required Customer Selector with clear badge -->
                    <StackPanel Orientation="Horizontal"
                                VerticalAlignment="Center"
                                Visibility="{Binding IsCreditSale, Converter={StaticResource BoolToVis}}"
                                Margin="0,2,16,2">
                        <Border Background="#FEF3C7"
                                BorderBrush="#F59E0B"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="8,4"
                                Margin="0,0,10,0">
                            <StackPanel Orientation="Horizontal">
                                <TextBlock Text="Customer *:"
                                           FontWeight="Bold"
                                           Foreground="#B45309"
                                           VerticalAlignment="Center"
                                           Margin="0,0,6,0" />
                                <ComboBox Width="220"
                                          ItemsSource="{Binding Customers}"
                                          SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                          DisplayMemberPath="Name"
                                          common:PlaceholderHelper.Placeholder="Select Customer (Req)..."
                                          VerticalContentAlignment="Center"
                                          VerticalAlignment="Center" />
                            </StackPanel>
                        </Border>
                    </StackPanel>

                    <!-- Reference / Doctor -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,16,2">
                        <TextBlock Text="Ref / Doctor:"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Margin="0,0,6,0" />
                        <TextBox Width="140"
                                 Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 common:PlaceholderHelper.Placeholder="e.g. Dr. Ali / Ref#12"
                                 VerticalAlignment="Center"
                                 Padding="6,4" />
                    </StackPanel>
                </WrapPanel>

                <!-- Search / Barcode Input Strip -->
                <Grid Grid.Row="2">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="15"
                             FontWeight="SemiBold"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"
                             common:PlaceholderHelper.Placeholder="Scan Barcode or Type Product Code / Name (Press Enter)..." />

                    <!-- Search Suggestions Popup for Multiple Disambiguation Matches -->
                    <Popup x:Name="SuggestionsPopup"
                           IsOpen="{Binding IsSuggestionPopupOpen, Mode=TwoWay}"
                           PlacementTarget="{Binding ElementName=SearchBox}"
                           Placement="Bottom"
                           StaysOpen="False"
                           AllowsTransparency="True"
                           Focusable="False"
                           PopupAnimation="Fade">
                        <Border Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="6"
                                Width="{Binding ActualWidth, ElementName=SearchBox}"
                                MaxHeight="280"
                                Padding="4"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="3" Opacity="0.2" Direction="270" />
                            </Border.Effect>
                            <DockPanel>
                                <Border DockPanel.Dock="Top" Background="{StaticResource Brush.Surface.Muted}" Padding="8,4" Margin="0,0,0,4" CornerRadius="4">
                                    <Grid>
                                        <TextBlock Text="Select product to add to bill:" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource Brush.Text.Secondary}" />
                                        <TextBlock Text="[Esc to close]" FontSize="10" Foreground="{StaticResource Brush.Text.Muted}" HorizontalAlignment="Right" />
                                    </Grid>
                                </Border>
                                <ListBox ItemsSource="{Binding SearchSuggestions}"
                                         SelectedItem="{Binding SelectedSuggestion, Mode=TwoWay}"
                                         BorderThickness="0"
                                         Background="Transparent"
                                         ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                    <ListBox.ItemContainerStyle>
                                        <Style TargetType="ListBoxItem">
                                            <Setter Property="Padding" Value="8,6" />
                                            <Setter Property="Cursor" Value="Hand" />
                                            <Setter Property="Template">
                                                <Setter.Value>
                                                    <ControlTemplate TargetType="ListBoxItem">
                                                        <Border x:Name="Bd" Background="{TemplateBinding Background}" CornerRadius="4" Padding="{TemplateBinding Padding}">
                                                            <ContentPresenter />
                                                        </Border>
                                                        <ControlTemplate.Triggers>
                                                            <Trigger Property="IsMouseOver" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="{StaticResource Brush.Surface.Muted}" />
                                                            </Trigger>
                                                            <Trigger Property="IsSelected" Value="True">
                                                                <Setter TargetName="Bd" Property="Background" Value="#E0E7FF" />
                                                            </Trigger>
                                                        </ControlTemplate.Triggers>
                                                    </ControlTemplate>
                                                </Setter.Value>
                                            </Setter>
                                        </Style>
                                    </ListBox.ItemContainerStyle>
                                    <ListBox.ItemTemplate>
                                        <DataTemplate>
                                            <Button Style="{StaticResource Button.Subtle}"
                                                    HorizontalContentAlignment="Stretch"
                                                    Padding="0"
                                                    Command="{Binding DataContext.SelectSuggestionCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                    CommandParameter="{Binding}">
                                                <Grid Margin="4,2">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="*" />
                                                        <ColumnDefinition Width="Auto" />
                                                        <ColumnDefinition Width="Auto" />
                                                    </Grid.ColumnDefinitions>
                                                    <StackPanel Grid.Column="0">
                                                        <TextBlock Text="{Binding Product.Name}" FontWeight="SemiBold" FontSize="13" Foreground="{StaticResource Brush.Text.Primary}" />
                                                        <StackPanel Orientation="Horizontal" Margin="0,2,0,0">
                                                            <TextBlock Text="{Binding Product.ProductCode}" FontSize="11" Foreground="{StaticResource Brush.Text.Muted}" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Product.CategoryName}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" Margin="0,0,8,0" />
                                                            <TextBlock Text="{Binding Product.ManufacturerName}" FontSize="11" Foreground="{StaticResource Brush.Text.Secondary}" />
                                                        </StackPanel>
                                                    </StackPanel>
                                                    <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="12,0" HorizontalAlignment="Right">
                                                        <TextBlock Text="{Binding TotalSaleableQuantity, StringFormat='Stock: {0:0.##}'}"
                                                                   FontSize="12"
                                                                   FontWeight="SemiBold"
                                                                   HorizontalAlignment="Right">
                                                            <TextBlock.Style>
                                                                <Style TargetType="TextBlock">
                                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" />
                                                                    <Style.Triggers>
                                                                        <DataTrigger Binding="{Binding Status}" Value="OutOfStock">
                                                                            <Setter Property="Foreground" Value="Crimson" />
                                                                            <Setter Property="Text" Value="Out of Stock" />
                                                                        </DataTrigger>
                                                                    </Style.Triggers>
                                                                </Style>
                                                            </TextBlock.Style>
                                                        </TextBlock>
                                                    </StackPanel>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding DefaultSalePrice, StringFormat='{}{0:N2}'}"
                                                               FontSize="13"
                                                               FontWeight="Bold"
                                                               Foreground="{StaticResource Brush.Primary}"
                                                               VerticalAlignment="Center"
                                                               MinWidth="60"
                                                               TextAlignment="Right" />
                                                </Grid>
                                            </Button>
                                        </DataTemplate>
                                    </ListBox.ItemTemplate>
                                </ListBox>
                            </DockPanel>
                        </Border>
                    </Popup>

                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Primary}"
                            Content="Add / Scan (Enter)"
                            Command="{Binding SearchOrScanCommand}"
                            Padding="16,8"
                            Margin="8,0,0,0"
                            FontWeight="SemiBold" />
                </Grid>

                <!-- Lookup State / Feedback Message (Requirement 15) -->
                <TextBlock Grid.Row="3"
                           Text="{Binding LookupStatusMessage}"
                           Margin="2,6,0,0"
                           FontSize="12"
                           FontWeight="Medium">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLookupError}" Value="True">
                                    <Setter Property="Foreground" Value="Crimson" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 2. CART ITEMS TABLE -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,12">
            <DataGrid x:Name="CartGrid"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- # -->
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding LineNumber}"
                                        Width="40"
                                        IsReadOnly="True" />

                    <!-- Product Code -->
                    <DataGridTextColumn Header="Code"
                                        Binding="{Binding ProductCode}"
                                        Width="90"
                                        IsReadOnly="True" />

                    <!-- Item Description -->
                    <DataGridTemplateColumn Header="Medicine Description" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AllocationsPreview}"
                                               FontSize="10"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Unit -->
                    <DataGridTextColumn Header="Unit"
                                        Binding="{Binding Unit}"
                                        Width="60"
                                        IsReadOnly="True" />

                    <!-- Available Stock -->
                    <DataGridTextColumn Header="Stock"
                                        Binding="{Binding AvailableStock, StringFormat='0.##'}"
                                        Width="65"
                                        IsReadOnly="True" />

                    <!-- Quantity (Editable) -->
                    <DataGridTextColumn Header="Qty"
                                        Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='0.##'}"
                                        Width="80" />

                    <!-- Unit Price -->
                    <DataGridTextColumn Header="Price"
                                        Binding="{Binding UnitSalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                        Width="85" />

                    <!-- Line Discount -->
                    <DataGridTextColumn Header="Discount"
                                        Binding="{Binding LineDiscountAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                        Width="80" />

                    <!-- Net Total -->
                    <DataGridTextColumn Header="Net Amount"
                                        Binding="{Binding NetLineAmount, StringFormat='N2'}"
                                        Width="105"
                                        IsReadOnly="True" />

                    <!-- Delete Action -->
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕"
                                        Style="{StaticResource Button.Outline}"
                                        Foreground="Crimson"
                                        Padding="6,2"
                                        FontSize="11"
                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. BOTTOM TOTALS & ACTIONS -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Additional Discounts & Remarks in a WrapPanel -->
                <WrapPanel Grid.Column="0" VerticalAlignment="Center" Margin="0,0,16,0">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,16,4">
                        <TextBlock Text="Invoice Discount:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <TextBox Width="90"
                                 Text="{Binding InvoiceDiscountAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                 VerticalAlignment="Center"
                                 Padding="6,4" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,16,4">
                        <TextBlock Text="Remarks:" VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="Medium" />
                        <TextBox Width="160"
                                 Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Padding="6,4" />
                    </StackPanel>
                </WrapPanel>

                <!-- Right: Total Payable & Primary POS Actions in WrapPanel -->
                <WrapPanel Grid.Column="1" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <!-- Total Payable Badge -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,16,4">
                        <TextBlock Text="Total Payable:"
                                   FontSize="15"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center"
                                   Margin="0,0,8,0" />
                        <Border Background="{StaticResource Brush.Primary}"
                                CornerRadius="6"
                                Padding="14,6">
                            <TextBlock Text="{Binding NetTotal, Converter={StaticResource CurrencyConverter}}"
                                       Foreground="White"
                                       FontSize="20"
                                       FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <!-- Action Buttons -->
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,4,0,4">
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Quick Cash (F12)"
                                Command="{Binding QuickCashSaleCommand}"
                                MinHeight="38"
                                Padding="14,8"
                                Margin="0,0,10,0"
                                FontWeight="SemiBold" />
                        <Button Style="{StaticResource Button.Primary}"
                                Content="Tender / Pay (F10)"
                                Command="{Binding OpenTenderModalCommand}"
                                MinHeight="38"
                                Padding="18,8"
                                FontSize="14"
                                FontWeight="Bold" />
                    </StackPanel>
                </WrapPanel>
            </Grid>
        </Border>

        <!-- 4. TENDER / PAYMENT MODAL POPUP -->
        <Border Grid.RowSpan="3"
                Background="#88000000"
                Visibility="{Binding IsTenderModalOpen, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="100">
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="440"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                               Text="Checkout &amp; Payment"
                               Style="{StaticResource Text.Display}"
                               FontSize="20"
                               Margin="0,0,0,16" />

                    <!-- Net Payable Amount -->
                    <Border Grid.Row="1"
                            Background="#F0F4F8"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Total Payable:" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NetTotal, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Primary}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Cash Tendered Input -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Cash Tendered:" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="TenderBox"
                                 Text="{Binding TenderedAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Padding="8"
                                 KeyDown="TenderBox_KeyDown" />
                    </StackPanel>

                    <!-- Change Returned -->
                    <Border Grid.Row="3"
                            Background="#EBF8EE"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Change Returned:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChangeGiven, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2E7D32"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Print Option Checkbox -->
                    <CheckBox Grid.Row="4"
                              Content="Print Invoice / Receipt after posting"
                              IsChecked="{Binding PrintReceiptOnSave, Mode=TwoWay}"
                              Margin="0,0,0,18"
                              FontWeight="Medium" />

                    <!-- Buttons -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Style="{StaticResource Button.Outline}"
                                Command="{Binding CloseTenderModalCommand}"
                                Margin="0,0,8,0"
                                Padding="0,10" />

                        <Button Grid.Column="1"
                                Content="Confirm &amp; Post (Enter)"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding CompleteSaleCommand}"
                                Margin="8,0,0,0"
                                Padding="0,10"
                                FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

