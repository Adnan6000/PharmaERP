<UserControl x:Class="PharmaERP.Desktop.Views.SalesEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:SalesEntryViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <UserControl.InputBindings>
        <KeyBinding Gesture="Ctrl+N" Command="{Binding ClearFormCommand}" />
        <KeyBinding Gesture="Ctrl+F" Command="{Binding FocusSearchCommand}" />
        <KeyBinding Key="F8" Command="{Binding ParkTicketCommand}" />
        <KeyBinding Key="F9" Command="{Binding RecallTicketCommand}" />
        <KeyBinding Key="F10" Command="{Binding OpenTenderModalCommand}" />
        <KeyBinding Key="F12" Command="{Binding QuickCashSaleCommand}" />
        <KeyBinding Key="Delete" Command="{Binding DeleteItemCommand}" />
        <KeyBinding Key="Escape" Command="{Binding EscapeCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <!-- Top Controls (Header & Barcode Search) -->
            <RowDefinition Height="Auto" />
            <!-- Cart Items Grid -->
            <RowDefinition Height="*" />
            <!-- Bottom Controls (Summary & Actions) -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. TOP CONTROLS & BARCODE SEARCH -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- Top Title & Customer Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <TextBlock Text="POS Counter"
                                   Style="{StaticResource Text.Display}"
                                   FontSize="20"
                                   VerticalAlignment="Center"
                                   Margin="0,0,16,0" />
                        <RadioButton Content="Cash Sale"
                                     IsChecked="{Binding IsCashSale, Mode=TwoWay}"
                                     VerticalAlignment="Center"
                                     Margin="0,0,12,0" />
                        <RadioButton Content="Credit Sale (Customer Req.)"
                                     IsChecked="{Binding IsCreditSale, Mode=TwoWay}"
                                     VerticalAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right">
                        <TextBlock Text="Customer: " VerticalAlignment="Center" Margin="0,0,6,0" FontWeight="SemiBold" />
                        <ComboBox Width="200"
                                  ItemsSource="{Binding Customers}"
                                  SelectedItem="{Binding SelectedCustomer, Mode=TwoWay}"
                                  DisplayMemberPath="Name"
                                  VerticalAlignment="Center"
                                  Margin="0,0,12,0" />
                        <TextBlock Text="Ref: " VerticalAlignment="Center" Margin="0,0,6,0" />
                        <TextBox Width="120"
                                 Text="{Binding Reference, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                 VerticalAlignment="Center"
                                 Margin="0,0,8,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Park (F8)"
                                Command="{Binding ParkTicketCommand}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                FontSize="11" />
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Recall (F9)"
                                Command="{Binding RecallTicketCommand}"
                                Padding="10,4"
                                Margin="0,0,6,0"
                                FontSize="11" />
                        <Button Style="{StaticResource Button.Outline}"
                                Content="Clear / New (Ctrl+N)"
                                Command="{Binding ClearFormCommand}"
                                Padding="10,4"
                                FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- Search / Barcode Input Strip -->
                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox x:Name="SearchBox"
                             Grid.Column="0"
                             Text="{Binding SearchTerm, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             FontSize="16"
                             FontWeight="SemiBold"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             KeyDown="SearchBox_KeyDown"
                             Tag="Scan Barcode or Type Product Code / Name (Press Enter) — [Ctrl+F]" />

                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Primary}"
                            Content="Add / Scan (Enter)"
                            Command="{Binding SearchOrScanCommand}"
                            Padding="16,8"
                            Margin="8,0,0,0"
                            FontWeight="SemiBold" />
                </Grid>

                <!-- Lookup State / Feedback Message (Requirement 15) -->
                <TextBlock Grid.Row="2"
                           Text="{Binding LookupStatusMessage}"
                           Margin="2,6,0,0"
                           FontSize="12"
                           FontWeight="Medium">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Foreground" Value="{StaticResource Brush.Primary}" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsLookupError}" Value="True">
                                    <Setter Property="Foreground" Value="Crimson" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </Border>

        <!-- 2. CART ITEMS TABLE -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Margin="0,0,0,12">
            <DataGrid x:Name="CartGrid"
                      ItemsSource="{Binding Items}"
                      SelectedItem="{Binding SelectedItem, Mode=TwoWay}"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      IsReadOnly="False"
                      GridLinesVisibility="Horizontal"
                      HeadersVisibility="Column"
                      BorderThickness="0"
                      Background="Transparent"
                      RowHeaderWidth="0"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <!-- # -->
                    <DataGridTextColumn Header="#"
                                        Binding="{Binding LineNumber}"
                                        Width="40"
                                        IsReadOnly="True" />

                    <!-- Product Code -->
                    <DataGridTextColumn Header="Code"
                                        Binding="{Binding ProductCode}"
                                        Width="90"
                                        IsReadOnly="True" />

                    <!-- Item Description -->
                    <DataGridTemplateColumn Header="Medicine Description" Width="*">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <StackPanel Margin="4,2">
                                    <TextBlock Text="{Binding ProductName}" FontWeight="SemiBold" />
                                    <TextBlock Text="{Binding AllocationsPreview}"
                                               FontSize="10"
                                               Foreground="{StaticResource Brush.TextMuted}" />
                                </StackPanel>
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>

                    <!-- Unit -->
                    <DataGridTextColumn Header="Unit"
                                        Binding="{Binding Unit}"
                                        Width="60"
                                        IsReadOnly="True" />

                    <!-- Available Stock -->
                    <DataGridTextColumn Header="Stock"
                                        Binding="{Binding AvailableStock, StringFormat='0.##'}"
                                        Width="65"
                                        IsReadOnly="True" />

                    <!-- Quantity (Editable) -->
                    <DataGridTextColumn Header="Qty"
                                        Binding="{Binding Quantity, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='0.##'}"
                                        Width="80" />

                    <!-- Unit Price -->
                    <DataGridTextColumn Header="Price"
                                        Binding="{Binding UnitSalePrice, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                        Width="85" />

                    <!-- Line Discount -->
                    <DataGridTextColumn Header="Discount"
                                        Binding="{Binding LineDiscountAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                        Width="80" />

                    <!-- Net Total -->
                    <DataGridTextColumn Header="Net Amount"
                                        Binding="{Binding NetLineAmount, StringFormat='N2'}"
                                        Width="105"
                                        IsReadOnly="True" />

                    <!-- Delete Action -->
                    <DataGridTemplateColumn Width="50">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Content="✕"
                                        Style="{StaticResource Button.Outline}"
                                        Foreground="Crimson"
                                        Padding="6,2"
                                        FontSize="11"
                                        Command="{Binding DataContext.DeleteItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                        CommandParameter="{Binding}" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 3. BOTTOM TOTALS & ACTIONS -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="18,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left: Additional Discounts & Remarks -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Invoice Discount: " VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="100"
                             Text="{Binding InvoiceDiscountAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                             VerticalAlignment="Center"
                             Margin="0,0,16,0" />
                    <TextBlock Text="Remarks: " VerticalAlignment="Center" Margin="0,0,6,0" />
                    <TextBox Width="180"
                             Text="{Binding Remarks, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                             VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center: Net Payable Badge -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            VerticalAlignment="Center"
                            Margin="20,0,24,0">
                    <TextBlock Text="Total Payable:"
                               FontSize="16"
                               FontWeight="SemiBold"
                               VerticalAlignment="Center"
                               Margin="0,0,8,0" />
                    <Border Background="{StaticResource Brush.Primary}"
                            CornerRadius="6"
                            Padding="14,6">
                        <TextBlock Text="{Binding NetTotal, Converter={StaticResource CurrencyConverter}}"
                                   Foreground="White"
                                   FontSize="22"
                                   FontWeight="Bold" />
                    </Border>
                </StackPanel>

                <!-- Right: Action Buttons -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Outline}"
                            Content="Quick Cash (F12)"
                            Command="{Binding QuickCashSaleCommand}"
                            Padding="16,10"
                            Margin="0,0,10,0"
                            FontWeight="SemiBold" />
                    <Button Style="{StaticResource Button.Primary}"
                            Content="Tender / Pay (F10)"
                            Command="{Binding OpenTenderModalCommand}"
                            Padding="20,10"
                            FontSize="14"
                            FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- 4. TENDER / PAYMENT MODAL POPUP -->
        <Border Grid.RowSpan="3"
                Background="#88000000"
                Visibility="{Binding IsTenderModalOpen, Converter={StaticResource BoolToVis}}"
                Panel.ZIndex="100">
            <Border Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="8"
                    Width="440"
                    Padding="24"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Title -->
                    <TextBlock Grid.Row="0"
                               Text="Checkout &amp; Payment"
                               Style="{StaticResource Text.Display}"
                               FontSize="20"
                               Margin="0,0,0,16" />

                    <!-- Net Payable Amount -->
                    <Border Grid.Row="1"
                            Background="#F0F4F8"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Total Payable:" FontSize="13" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding NetTotal, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="20"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Primary}"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Cash Tendered Input -->
                    <StackPanel Grid.Row="2" Margin="0,0,0,12">
                        <TextBlock Text="Cash Tendered:" FontWeight="SemiBold" Margin="0,0,0,4" />
                        <TextBox x:Name="TenderBox"
                                 Text="{Binding TenderedAmount, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged, StringFormat='N2'}"
                                 FontSize="18"
                                 FontWeight="Bold"
                                 Padding="8"
                                 KeyDown="TenderBox_KeyDown" />
                    </StackPanel>

                    <!-- Change Returned -->
                    <Border Grid.Row="3"
                            Background="#EBF8EE"
                            CornerRadius="6"
                            Padding="12"
                            Margin="0,0,0,14">
                        <Grid>
                            <TextBlock Text="Change Returned:" FontSize="13" FontWeight="SemiBold" VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ChangeGiven, Converter={StaticResource CurrencyConverter}}"
                                       FontSize="18"
                                       FontWeight="Bold"
                                       Foreground="#2E7D32"
                                       HorizontalAlignment="Right" />
                        </Grid>
                    </Border>

                    <!-- Print Option Checkbox -->
                    <CheckBox Grid.Row="4"
                              Content="Print Invoice / Receipt after posting"
                              IsChecked="{Binding PrintReceiptOnSave, Mode=TwoWay}"
                              Margin="0,0,0,18"
                              FontWeight="Medium" />

                    <!-- Buttons -->
                    <Grid Grid.Row="5">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <Button Grid.Column="0"
                                Content="Cancel"
                                Style="{StaticResource Button.Outline}"
                                Command="{Binding CloseTenderModalCommand}"
                                Margin="0,0,8,0"
                                Padding="0,10" />

                        <Button Grid.Column="1"
                                Content="Confirm &amp; Post (Enter)"
                                Style="{StaticResource Button.Primary}"
                                Command="{Binding CompleteSaleCommand}"
                                Margin="8,0,0,0"
                                Padding="0,10"
                                FontWeight="Bold" />
                    </Grid>
                </Grid>
            </Border>
        </Border>
    </Grid>
</UserControl>

