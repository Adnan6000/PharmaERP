<UserControl x:Class="PharmaERP.Desktop.Views.ProductsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             xmlns:common="clr-namespace:PharmaERP.Desktop.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ProductsViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- MAIN WORKSPACE -->
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <!-- Top Page Header -->
                <RowDefinition Height="Auto" />
                <!-- Filters / Search Toolbar -->
                <RowDefinition Height="Auto" />
                <!-- DataGrid Table -->
                <RowDefinition Height="*" />
                <!-- Pagination Footer -->
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- 1. PAGE HEADER -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="Product Catalog"
                               Style="{StaticResource Text.Display}"
                               Margin="0,0,0,4" />
                    <TextBlock Text="Manage medicines, pricing, reorder levels, and master attributes."
                               Foreground="{StaticResource Brush.Text.Secondary}"
                               FontSize="13" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Style="{StaticResource Button.Outline}"
                            Command="{Binding RefreshCommand}"
                            Padding="12,7"
                            Margin="0,0,10,0">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="🔄" Margin="0,0,6,0" />
                            <TextBlock Text="Refresh (F5)" />
                        </StackPanel>
                    </Button>

                    <Button Style="{StaticResource Button.Primary}"
                            Command="{Binding NewProductCommand}"
                            Padding="14,7">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="➕" Margin="0,0,6,0" />
                            <TextBlock Text="New Product (Ctrl+N)" />
                        </StackPanel>
                    </Button>
                </StackPanel>
            </Grid>

            <!-- 2. SEARCH & FILTER TOOLBAR -->
            <Border Grid.Row="1"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Padding="14,10"
                    Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <!-- Search Box -->
                        <ColumnDefinition Width="280" />
                        <!-- Category Filter -->
                        <ColumnDefinition Width="180" />
                        <!-- Manufacturer Filter -->
                        <ColumnDefinition Width="180" />
                        <!-- Status Filter -->
                        <ColumnDefinition Width="140" />
                        <!-- Spacer -->
                        <ColumnDefinition Width="*" />
                        <!-- Clear Filters -->
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search Input -->
                    <Grid Grid.Column="0" Margin="0,0,10,0">
                        <TextBox Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                                 common:PlaceholderHelper.Placeholder="Search by name, code, barcode..."
                                 Padding="28,6,8,6"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="🔍"
                                   Foreground="{StaticResource Brush.Text.Muted}"
                                   VerticalAlignment="Center"
                                   Margin="8,0,0,0"
                                   IsHitTestVisible="False" />
                    </Grid>

                    <!-- Category Filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding Categories}"
                              SelectedValue="{Binding SelectedCategoryFilter}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              common:ClearableHelper.IsClearable="True"
                              common:PlaceholderHelper.Placeholder="All Categories"
                              Margin="0,0,10,0"
                              VerticalContentAlignment="Center" />

                    <!-- Manufacturer Filter -->
                    <ComboBox Grid.Column="2"
                              ItemsSource="{Binding Manufacturers}"
                              SelectedValue="{Binding SelectedManufacturerFilter}"
                              SelectedValuePath="Id"
                              DisplayMemberPath="Name"
                              common:ClearableHelper.IsClearable="True"
                              common:PlaceholderHelper.Placeholder="All Manufacturers"
                              Margin="0,0,10,0"
                              VerticalContentAlignment="Center" />

                    <!-- Clear Filters Button -->
                    <Button Grid.Column="5"
                            Style="{StaticResource Button.Outline}"
                            Content="Reset Filters"
                            Command="{Binding ClearFiltersCommand}"
                            Padding="10,4"
                            FontSize="12" />
                </Grid>
            </Border>

            <!-- 3. PRODUCTS DATAGRID -->
            <Border Grid.Row="2"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6">
                <Grid>
                    <DataGrid ItemsSource="{Binding Items}"
                              SelectedItem="{Binding SelectedItem}"
                              BorderThickness="0">
                        <DataGrid.Columns>
                            <!-- Code -->
                            <DataGridTextColumn Header="Code"
                                                Binding="{Binding ProductCode}"
                                                Width="110" />

                            <!-- Name -->
                            <DataGridTemplateColumn Header="Product Name" Width="*">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <TextBlock Text="{Binding Name}"
                                                   FontWeight="SemiBold"
                                                   Foreground="{StaticResource Brush.Text.Primary}"
                                                   VerticalAlignment="Center" />
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Category -->
                            <DataGridTextColumn Header="Category"
                                                Binding="{Binding CategoryName}"
                                                Width="140" />

                            <!-- Manufacturer -->
                            <DataGridTextColumn Header="Manufacturer"
                                                Binding="{Binding ManufacturerName}"
                                                Width="150" />

                            <!-- Unit -->
                            <DataGridTextColumn Header="Unit"
                                                Binding="{Binding UnitAbbreviation}"
                                                Width="80" />

                            <!-- Purchase Price -->
                            <DataGridTextColumn Header="Purchase Price"
                                                Binding="{Binding DefaultPurchasePrice, StringFormat='{}{0:N2}'}"
                                                Width="110" />

                            <!-- Sale Price -->
                            <DataGridTextColumn Header="Sale Price"
                                                Binding="{Binding DefaultSalePrice, StringFormat='{}{0:N2}'}"
                                                Width="110" />

                            <!-- Status -->
                            <DataGridTemplateColumn Header="Status" Width="90">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <Border CornerRadius="4"
                                                Padding="6,2"
                                                HorizontalAlignment="Left"
                                                Background="{Binding IsActive, Converter={StaticResource BoolToVis}, ConverterParameter='badge'}">
                                            <TextBlock Text="{Binding IsActive, Converter={x:Null}}"
                                                       FontSize="11"
                                                       FontWeight="Medium">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="Active" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Status.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsActive}" Value="False">
                                                                <Setter Property="Text" Value="Inactive" />
                                                                <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Border>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>

                            <!-- Row Actions -->
                            <DataGridTemplateColumn Header="Actions" Width="120">
                                <DataGridTemplateColumn.CellTemplate>
                                    <DataTemplate>
                                        <StackPanel Orientation="Horizontal">
                                            <Button Style="{StaticResource Button.Subtle}"
                                                    Content="Edit"
                                                    Command="{Binding DataContext.EditProductCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}"
                                                    Margin="0,0,6,0" />
                                            <Button Style="{StaticResource Button.Subtle}"
                                                    Content="Toggle"
                                                    Command="{Binding DataContext.ToggleActiveCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                                    CommandParameter="{Binding}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </DataGridTemplateColumn.CellTemplate>
                            </DataGridTemplateColumn>
                        </DataGrid.Columns>
                    </DataGrid>

                    <!-- Loading / Empty Overlay -->
                    <Border Background="#80FFFFFF"
                            Visibility="{Binding IsLoading, Converter={StaticResource BoolToVis}}">
                        <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                            <TextBlock Text="Loading products..."
                                       FontWeight="SemiBold"
                                       Foreground="{StaticResource Brush.Text.Secondary}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>

            <!-- 4. PAGINATION FOOTER -->
            <Grid Grid.Row="3" Margin="0,12,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <TextBlock Grid.Column="0"
                           Text="{Binding PageInfoText}"
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontSize="12"
                           VerticalAlignment="Center" />

                <StackPanel Grid.Column="1" Orientation="Horizontal">
                    <Button Style="{StaticResource Button.Outline}"
                            Content="⏮ First"
                            Command="{Binding FirstPageCommand}"
                            Padding="8,4"
                            FontSize="11"
                            Margin="0,0,4,0" />
                    <Button Style="{StaticResource Button.Outline}"
                            Content="◀ Prev"
                            Command="{Binding PreviousPageCommand}"
                            Padding="8,4"
                            FontSize="11"
                            Margin="0,0,4,0" />
                    <Button Style="{StaticResource Button.Outline}"
                            Content="Next ▶"
                            Command="{Binding NextPageCommand}"
                            Padding="8,4"
                            FontSize="11"
                            Margin="0,0,4,0" />
                    <Button Style="{StaticResource Button.Outline}"
                            Content="Last ⏭"
                            Command="{Binding LastPageCommand}"
                            Padding="8,4"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- DRAWER / MODAL EDIT FORM OVERLAY -->
        <Grid Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}">
            <!-- Scrim / Backdrop -->
            <Border Background="#66000000" MouseDown="OnScrimMouseDown" />

            <!-- Drawer Container Panel -->
            <Border HorizontalAlignment="Right"
                    Width="460"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>

                    <!-- Drawer Header -->
                    <Border Grid.Row="0"
                            Background="{StaticResource Brush.Surface.Muted}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,0,0,1"
                            Padding="20,16">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <TextBlock Grid.Column="0"
                                       Text="{Binding DrawerTitle}"
                                       FontSize="16"
                                       FontWeight="Bold"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       VerticalAlignment="Center" />

                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Subtle}"
                                    Content="✕"
                                    FontSize="16"
                                    Command="{Binding CancelEditCommand}" />
                        </Grid>
                    </Border>

                    <!-- Drawer Body / Form Fields -->
                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Padding="20">
                        <StackPanel>
                            <!-- Error Notice (Validation / Duplicate / Concurrency) -->
                            <Border Background="{StaticResource Brush.Status.Error.Bg}"
                                    BorderBrush="{StaticResource Brush.Status.Error}"
                                    BorderThickness="1"
                                    CornerRadius="5"
                                    Padding="12"
                                    Margin="0,0,0,16"
                                    Visibility="{Binding FormErrorMessage, Converter={StaticResource NullToVis}}">
                                <TextBlock Text="{Binding FormErrorMessage}"
                                           Foreground="{StaticResource Brush.Status.Error}"
                                           FontSize="12"
                                           TextWrapping="Wrap" />
                            </Border>

                            <!-- Name Field -->
                            <TextBlock Text="Product Name *" Style="{StaticResource Form.Label}" />
                            <TextBox Text="{Binding FormName, UpdateSourceTrigger=PropertyChanged}"
                                     common:PlaceholderHelper.Placeholder="e.g. Panadol 500mg Tablet"
                                     Margin="0,0,0,14" />

                            <!-- Code and Barcode in 2 columns -->
                            <Grid Margin="0,0,0,14">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Product Code" Style="{StaticResource Form.Label}" />
                                    <TextBox Text="{Binding FormProductCode, UpdateSourceTrigger=PropertyChanged}"
                                             common:PlaceholderHelper.Placeholder="e.g. MED-00123" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Barcode" Style="{StaticResource Form.Label}" />
                                    <TextBox Text="{Binding FormBarcode, UpdateSourceTrigger=PropertyChanged}"
                                             common:PlaceholderHelper.Placeholder="Scan or type barcode..." />
                                </StackPanel>
                            </Grid>

                            <!-- Category -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Category" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Subtle}"
                                        Content="+ Add New"
                                        FontSize="11"
                                        Padding="6,2"
                                        Command="{Binding OpenQuickAddCategoryCommand}" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding Categories}"
                                      SelectedValue="{Binding FormCategoryId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      common:ClearableHelper.IsClearable="True"
                                      common:PlaceholderHelper.Placeholder="Select Category..."
                                      Margin="0,0,0,14"
                                      Visibility="{Binding HasCategories, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{StaticResource Brush.Surface.Muted}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding HasCategories, Converter={StaticResource InverseBoolToVis}}">
                                <Grid>
                                    <TextBlock Text="No categories exist yet." FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Button.Outline}"
                                            Content="+ Create Category"
                                            FontSize="11"
                                            Padding="8,3"
                                            HorizontalAlignment="Right"
                                            Command="{Binding OpenQuickAddCategoryCommand}" />
                                </Grid>
                            </Border>

                            <!-- Manufacturer -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Manufacturer / Company" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Subtle}"
                                        Content="+ Add New"
                                        FontSize="11"
                                        Padding="6,2"
                                        Command="{Binding OpenQuickAddManufacturerCommand}" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding Manufacturers}"
                                      SelectedValue="{Binding FormManufacturerId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      common:ClearableHelper.IsClearable="True"
                                      common:PlaceholderHelper.Placeholder="Select Manufacturer..."
                                      Margin="0,0,0,14"
                                      Visibility="{Binding HasManufacturers, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{StaticResource Brush.Surface.Muted}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding HasManufacturers, Converter={StaticResource InverseBoolToVis}}">
                                <Grid>
                                    <TextBlock Text="No manufacturers exist yet." FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Button.Outline}"
                                            Content="+ Create Manufacturer"
                                            FontSize="11"
                                            Padding="8,3"
                                            HorizontalAlignment="Right"
                                            Command="{Binding OpenQuickAddManufacturerCommand}" />
                                </Grid>
                            </Border>

                            <!-- Unit of Measure -->
                            <Grid Margin="0,0,0,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Grid.Column="0" Text="Unit of Measure" Style="{StaticResource Form.Label}" VerticalAlignment="Center" Margin="0" />
                                <Button Grid.Column="1"
                                        Style="{StaticResource Button.Subtle}"
                                        Content="+ Add New"
                                        FontSize="11"
                                        Padding="6,2"
                                        Command="{Binding OpenQuickAddUnitCommand}" />
                            </Grid>
                            <ComboBox ItemsSource="{Binding Units}"
                                      SelectedValue="{Binding FormUnitId}"
                                      SelectedValuePath="Id"
                                      DisplayMemberPath="Name"
                                      common:ClearableHelper.IsClearable="True"
                                      common:PlaceholderHelper.Placeholder="Select Unit..."
                                      Margin="0,0,0,14"
                                      Visibility="{Binding HasUnits, Converter={StaticResource BoolToVis}}" />
                            <Border Background="{StaticResource Brush.Surface.Muted}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10,8"
                                    Margin="0,0,0,14"
                                    Visibility="{Binding HasUnits, Converter={StaticResource InverseBoolToVis}}">
                                <Grid>
                                    <TextBlock Text="No units exist yet." FontSize="12" Foreground="{StaticResource Brush.Text.Muted}" VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Button.Outline}"
                                            Content="+ Create Unit"
                                            FontSize="11"
                                            Padding="8,3"
                                            HorizontalAlignment="Right"
                                            Command="{Binding OpenQuickAddUnitCommand}" />
                                </Grid>
                            </Border>

                            <!-- Pricing (Purchase & Sale) in 2 columns -->
                            <Grid Margin="0,0,0,16">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="12" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Purchase Price" Style="{StaticResource Form.Label}" />
                                    <TextBox Text="{Binding FormDefaultPurchasePrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                             common:PlaceholderHelper.Placeholder="0.00" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Sale Price" Style="{StaticResource Form.Label}" />
                                    <TextBox Text="{Binding FormDefaultSalePrice, UpdateSourceTrigger=PropertyChanged, StringFormat='{}{0:F2}'}"
                                             common:PlaceholderHelper.Placeholder="0.00" />
                                </StackPanel>
                            </Grid>

                            <!-- Active Status Toggle Switch -->
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,6,0,0">
                                <ToggleButton IsChecked="{Binding FormIsActive, Mode=TwoWay}"
                                              Style="{StaticResource Switch.Toggle}"
                                              VerticalAlignment="Center"
                                              Margin="0,0,12,0" />
                                <TextBlock VerticalAlignment="Center" FontSize="13" FontWeight="SemiBold">
                                    <TextBlock.Style>
                                        <Style TargetType="TextBlock">
                                            <Setter Property="Text" Value="Product is Active and available for billing" />
                                            <Setter Property="Foreground" Value="{StaticResource Brush.Text.Primary}" />
                                            <Style.Triggers>
                                                <DataTrigger Binding="{Binding FormIsActive}" Value="False">
                                                    <Setter Property="Text" Value="Product is Inactive (Hidden from billing)" />
                                                    <Setter Property="Foreground" Value="{StaticResource Brush.Text.Muted}" />
                                                </DataTrigger>
                                            </Style.Triggers>
                                        </Style>
                                    </TextBlock.Style>
                                </TextBlock>
                            </StackPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Drawer Footer -->
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.Surface.Muted}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="20,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <Button Grid.Column="1"
                                    Style="{StaticResource Button.Outline}"
                                    Content="Cancel (Esc)"
                                    Command="{Binding CancelEditCommand}"
                                    Margin="0,0,10,0"
                                    Padding="14,8" />

                            <Button Grid.Column="2"
                                    Style="{StaticResource Button.Primary}"
                                    Content="Save Product (Ctrl+S)"
                                    Command="{Binding SaveProductCommand}"
                                    Padding="16,8" />
                        </Grid>
                    </Border>

                    <!-- IN-DRAWER QUICK-ADD MODAL OVERLAY -->
                    <Grid Grid.RowSpan="3"
                          Visibility="{Binding IsQuickAddOpen, Converter={StaticResource BoolToVis}}">
                        <Border Background="#99000000" />
                        <Border HorizontalAlignment="Center"
                                VerticalAlignment="Center"
                                Width="380"
                                Background="{StaticResource Brush.Surface}"
                                BorderBrush="{StaticResource Brush.Border}"
                                BorderThickness="1"
                                CornerRadius="8"
                                Padding="20"
                                SnapsToDevicePixels="True">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="20" ShadowDepth="4" Opacity="0.3" Direction="270" />
                            </Border.Effect>
                            <StackPanel>
                                <Grid Margin="0,0,0,16">
                                    <TextBlock Text="{Binding QuickAddTitle}"
                                               FontSize="16"
                                               FontWeight="Bold"
                                               Foreground="{StaticResource Brush.Text.Primary}"
                                               VerticalAlignment="Center" />
                                    <Button Style="{StaticResource Button.Subtle}"
                                            Content="✕"
                                            FontSize="14"
                                            HorizontalAlignment="Right"
                                            Command="{Binding CancelQuickAddCommand}" />
                                </Grid>

                                <!-- Quick-Add Error Notice -->
                                <Border Background="{StaticResource Brush.Status.Error.Bg}"
                                        BorderBrush="{StaticResource Brush.Status.Error}"
                                        BorderThickness="1"
                                        CornerRadius="4"
                                        Padding="8"
                                        Margin="0,0,0,12"
                                        Visibility="{Binding QuickAddErrorMessage, Converter={StaticResource NullToVis}}">
                                    <TextBlock Text="{Binding QuickAddErrorMessage}"
                                               Foreground="{StaticResource Brush.Status.Error}"
                                               FontSize="12"
                                               TextWrapping="Wrap" />
                                </Border>

                                <!-- Name Input -->
                                <TextBlock Text="Name *" Style="{StaticResource Form.Label}" />
                                <TextBox Text="{Binding QuickAddName, UpdateSourceTrigger=PropertyChanged}"
                                         common:PlaceholderHelper.Placeholder="Enter name..."
                                         Margin="0,0,0,14" />

                                <!-- Abbreviation for Unit -->
                                <StackPanel Visibility="{Binding IsUnitQuickAdd, Converter={StaticResource BoolToVis}}">
                                    <TextBlock Text="Abbreviation (e.g. Tab, Cap) *" Style="{StaticResource Form.Label}" />
                                    <TextBox Text="{Binding QuickAddAbbreviation, UpdateSourceTrigger=PropertyChanged}"
                                             common:PlaceholderHelper.Placeholder="e.g. Tab"
                                             Margin="0,0,0,14" />
                                </StackPanel>

                                <!-- Action Buttons -->
                                <Grid Margin="0,6,0,0">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>

                                    <Button Grid.Column="1"
                                            Style="{StaticResource Button.Outline}"
                                            Content="Cancel"
                                            Command="{Binding CancelQuickAddCommand}"
                                            Padding="12,6"
                                            Margin="0,0,8,0" />

                                    <Button Grid.Column="2"
                                            Style="{StaticResource Button.Primary}"
                                            Content="Save &amp; Select"
                                            Command="{Binding SaveQuickAddCommand}"
                                            Padding="14,6" />
                                </Grid>
                            </StackPanel>
                        </Border>
                    </Grid>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</UserControl>

