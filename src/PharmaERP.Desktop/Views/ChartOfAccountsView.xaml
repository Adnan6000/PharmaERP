<UserControl x:Class="PharmaERP.Desktop.Views.ChartOfAccountsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             xmlns:common="clr-namespace:PharmaERP.Desktop.Common"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:ChartOfAccountsViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid>
        <!-- MAIN CONTENT -->
        <Grid Margin="24,20">
            <Grid.RowDefinitions>
                <!-- Header -->
                <RowDefinition Height="Auto" />
                <!-- Toolbar / Filter -->
                <RowDefinition Height="Auto" />
                <!-- Error / Status -->
                <RowDefinition Height="Auto" />
                <!-- Grid -->
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Page Title -->
            <Grid Grid.Row="0" Margin="0,0,0,16">
                <StackPanel>
                    <TextBlock Text="Chart of Accounts (COA)" Style="{StaticResource Text.Display}" />
                    <TextBlock Text="Hierarchical general ledger accounts, classifications, and system posting roles."
                               Foreground="{StaticResource Brush.Text.Secondary}" FontSize="13" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>

            <!-- Action / Filter Toolbar -->
            <Border Grid.Row="1" Style="{StaticResource Card.Default}" Padding="12" Margin="0,0,0,14">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="280" />
                        <ColumnDefinition Width="200" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <!-- Search -->
                    <TextBox Grid.Column="0"
                             Text="{Binding SearchTerm, UpdateSourceTrigger=PropertyChanged}"
                             common:PlaceholderHelper.Placeholder="Search code or account name..."
                             Style="{StaticResource Form.Input}"
                             Margin="0,0,12,0" />

                    <!-- Account Type Filter -->
                    <ComboBox Grid.Column="1"
                              ItemsSource="{Binding AccountTypes}"
                              SelectedItem="{Binding SelectedTypeFilter}"
                              common:ClearableHelper.IsClearable="True"
                              common:PlaceholderHelper.Placeholder="All Account Types"
                              Margin="0,0,12,0" />

                    <!-- Right Buttons -->
                    <StackPanel Grid.Column="3" Orientation="Horizontal">
                        <Button Style="{StaticResource Button.Outline}"
                                Content="🔄 Refresh"
                                Command="{Binding RefreshCommand}"
                                Padding="12,6"
                                Margin="0,0,8,0" />
                        <Button Style="{StaticResource Button.Primary}"
                                Content="+ New Account"
                                Command="{Binding OpenNewAccountDrawerCommand}"
                                Padding="14,6" />
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Error Banner -->
            <Border Grid.Row="2"
                    Background="{StaticResource Brush.Status.Error.Bg}"
                    BorderBrush="{StaticResource Brush.Status.Error}"
                    BorderThickness="1"
                    CornerRadius="4"
                    Padding="12,8"
                    Margin="0,0,0,12"
                    Visibility="{Binding ErrorMessage, Converter={StaticResource NullToVis}}">
                <TextBlock Text="{Binding ErrorMessage}" Foreground="{StaticResource Brush.Status.Error}" FontSize="12" />
            </Border>

            <!-- Accounts DataGrid -->
            <Border Grid.Row="3" Style="{StaticResource Card.Default}" Padding="0">
                <DataGrid ItemsSource="{Binding Accounts}"
                          SelectedItem="{Binding SelectedAccount}"
                          AutoGenerateColumns="False"
                          IsReadOnly="True"
                          CanUserAddRows="False"
                          GridLinesVisibility="Horizontal"
                          HeadersVisibility="Column"
                          BorderThickness="0"
                          RowHeight="36">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Code" Binding="{Binding AccountCode}" Width="110" FontWeight="SemiBold" />
                        <DataGridTextColumn Header="Account Name" Binding="{Binding Name}" Width="280" />
                        <DataGridTextColumn Header="Type" Binding="{Binding AccountType}" Width="120" />
                        <DataGridTextColumn Header="System Role" Binding="{Binding SystemAccountType}" Width="180" />
                        <DataGridCheckBoxColumn Header="Allow Posting" Binding="{Binding AllowPosting}" Width="95" />
                        <DataGridTextColumn Header="Parent Account" Binding="{Binding ParentAccountName}" Width="160" />
                        <DataGridCheckBoxColumn Header="Active" Binding="{Binding IsActive}" Width="70" />
                        <DataGridTextColumn Header="Description" Binding="{Binding Description}" Width="*" />
                    </DataGrid.Columns>
                </DataGrid>
            </Border>
        </Grid>

        <!-- RIGHT DRAWER: NEW ACCOUNT FORM -->
        <Grid Visibility="{Binding IsDrawerOpen, Converter={StaticResource BoolToVis}}"
              Background="#66000000">
            <Border Width="420"
                    HorizontalAlignment="Right"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1,0,0,0"
                    Padding="24">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <TextBlock Text="New Ledger Account" Style="{StaticResource Text.Subheading}" Margin="0,0,0,16" />

                        <!-- Error Message -->
                        <Border Background="{StaticResource Brush.Status.Error.Bg}"
                                BorderBrush="{StaticResource Brush.Status.Error}"
                                BorderThickness="1"
                                CornerRadius="4"
                                Padding="10"
                                Margin="0,0,0,12"
                                Visibility="{Binding FormErrorMessage, Converter={StaticResource NullToVis}}">
                            <TextBlock Text="{Binding FormErrorMessage}" Foreground="{StaticResource Brush.Status.Error}" FontSize="11" TextWrapping="Wrap" />
                        </Border>

                        <TextBlock Text="Account Code *" Style="{StaticResource Form.Label}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormAccountCode, UpdateSourceTrigger=PropertyChanged}"
                                 common:PlaceholderHelper.Placeholder="e.g. 1010"
                                 Style="{StaticResource Form.Input}" Margin="0,0,0,12" />

                        <TextBlock Text="Account Name *" Style="{StaticResource Form.Label}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormAccountName, UpdateSourceTrigger=PropertyChanged}"
                                 common:PlaceholderHelper.Placeholder="e.g. Cash in Hand"
                                 Style="{StaticResource Form.Input}" Margin="0,0,0,12" />

                        <TextBlock Text="Account Type *" Style="{StaticResource Form.Label}" Margin="0,0,0,4" />
                        <ComboBox ItemsSource="{Binding AccountTypes}"
                                  SelectedItem="{Binding FormAccountType}"
                                  Margin="0,0,0,12" />

                        <TextBlock Text="Description" Style="{StaticResource Form.Label}" Margin="0,0,0,4" />
                        <TextBox Text="{Binding FormDescription, UpdateSourceTrigger=PropertyChanged}"
                                 common:PlaceholderHelper.Placeholder="Optional account notes..."
                                 Style="{StaticResource Form.Input}"
                                 Height="60"
                                 TextWrapping="Wrap"
                                 AcceptsReturn="True"
                                 Margin="0,0,0,12" />

                        <CheckBox IsChecked="{Binding FormAllowPosting}"
                                  Content="Allow direct journal entries (Postable)"
                                  FontWeight="SemiBold"
                                  Margin="0,0,0,20" />

                        <!-- Action Buttons -->
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                            <Button Style="{StaticResource Button.Outline}"
                                    Content="Cancel"
                                    Command="{Binding CloseDrawerCommand}"
                                    Margin="0,0,10,0"
                                    Padding="14,8" />
                            <Button Style="{StaticResource Button.Primary}"
                                    Content="Save Account"
                                    Command="{Binding SaveAccountCommand}"
                                    Padding="16,8" />
                        </StackPanel>
                    </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>
    </Grid>
</UserControl>