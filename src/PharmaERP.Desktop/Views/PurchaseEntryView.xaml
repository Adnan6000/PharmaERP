<UserControl x:Class="PharmaERP.Desktop.Views.PurchaseEntryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
             xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
             mc:Ignorable="d"
             d:DataContext="{d:DesignInstance Type=vm:PurchaseEntryViewModel}">

    <UserControl.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
    </UserControl.Resources>

    <Grid Margin="24,18">
        <Grid.RowDefinitions>
            <!-- Header (Supplier & Invoice Metadata) -->
            <RowDefinition Height="Auto" />
            <!-- Line Entry Input Strip -->
            <RowDefinition Height="Auto" />
            <!-- Line Items Table -->
            <RowDefinition Height="*" />
            <!-- Footer & Actions -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. INVOICE HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,14"
                Margin="0,0,0,12">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,10">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="Purchase Invoice Entry (F2)"
                               Style="{StaticResource Text.Display}"
                               FontSize="18" />
                    <Button Grid.Column="1"
                            Style="{StaticResource Button.Outline}"
                            Content="Clear All"
                            Command="{Binding ClearFormCommand}"
                            Padding="10,4"
                            FontSize="11" />
                </Grid>

                <Grid Grid.Row="1">
                    <Grid.ColumnDefinitions>
                        <!-- Supplier Selector -->
                        <ColumnDefinition Width="260" />
                        <!-- Supplier Bill # -->
                        <ColumnDefinition Width="180" />
                        <!-- Invoice Date -->
                        <ColumnDefinition Width="150" />
                        <!-- Due Date -->
                        <ColumnDefinition Width="150" />
                        <!-- Remarks -->
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Grid.Column="0" Margin="0,0,12,0">
                        <TextBlock Text="Supplier *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <ComboBox ItemsSource="{Binding Suppliers}"
                                  SelectedItem="{Binding SelectedSupplier}"
                                  DisplayMemberPath="Name"
                                  Height="32"
                                  VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Margin="0,0,12,0">
                        <TextBlock Text="Supplier Bill / Inv #" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <TextBox Text="{Binding SupplierInvoiceNumber, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="2" Margin="0,0,12,0">
                        <TextBlock Text="Invoice Date *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <DatePicker SelectedDate="{Binding InvoiceDate}"
                                    Height="32"
                                    VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="3" Margin="0,0,12,0">
                        <TextBlock Text="Due Date" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <DatePicker SelectedDate="{Binding DueDate}"
                                    Height="32"
                                    VerticalContentAlignment="Center" />
                    </StackPanel>

                    <StackPanel Grid.Column="4">
                        <TextBlock Text="Remarks" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                        <TextBox Text="{Binding Remarks, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 VerticalContentAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>

        <!-- 2. LINE ENTRY STRIP -->
        <Border Grid.Row="1"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Product -->
                    <ColumnDefinition Width="220" />
                    <!-- Batch -->
                    <ColumnDefinition Width="130" />
                    <!-- Expiry -->
                    <ColumnDefinition Width="130" />
                    <!-- Mfg Date -->
                    <ColumnDefinition Width="130" />
                    <!-- Qty -->
                    <ColumnDefinition Width="90" />
                    <!-- Rate -->
                    <ColumnDefinition Width="100" />
                    <!-- Sale Rate -->
                    <ColumnDefinition Width="100" />
                    <!-- Discount -->
                    <ColumnDefinition Width="90" />
                    <!-- Line Total -->
                    <ColumnDefinition Width="100" />
                    <!-- Add Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                    <TextBlock Text="Product *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <ComboBox ItemsSource="{Binding Products}"
                              SelectedItem="{Binding SelectedProductForLine}"
                              DisplayMemberPath="Name"
                              Height="30"
                              VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="1" Margin="0,0,8,0">
                    <TextBlock Text="Batch #" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <TextBox Text="{Binding LineBatchNumber, UpdateSourceTrigger=PropertyChanged}"
                             Height="30"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="2" Margin="0,0,8,0">
                    <TextBlock Text="Expiry Date *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <DatePicker SelectedDate="{Binding LineExpiryDate}"
                                Height="30"
                                VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="3" Margin="0,0,8,0">
                    <TextBlock Text="Mfg Date" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <DatePicker SelectedDate="{Binding LineManufacturingDate}"
                                Height="30"
                                VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="4" Margin="0,0,8,0">
                    <TextBlock Text="Quantity *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <TextBox Text="{Binding LineQuantity, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                             Height="30"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="5" Margin="0,0,8,0">
                    <TextBlock Text="Purchase Rate *" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <TextBox Text="{Binding LinePurchaseRate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                             Height="30"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="6" Margin="0,0,8,0">
                    <TextBlock Text="Sale Rate" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <TextBox Text="{Binding LineSuggestedSaleRate, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                             Height="30"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="7" Margin="0,0,8,0">
                    <TextBlock Text="Discount" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <TextBox Text="{Binding LineDiscountAmount, UpdateSourceTrigger=PropertyChanged, StringFormat={}{0:N2}}"
                             Height="30"
                             VerticalContentAlignment="Center" />
                </StackPanel>

                <StackPanel Grid.Column="8" Margin="0,0,8,0">
                    <TextBlock Text="Total" FontWeight="SemiBold" FontSize="11" Margin="0,0,0,3" />
                    <Border Background="{StaticResource Brush.Surface.Muted}" Height="30" Padding="6,0">
                        <TextBlock Text="{Binding LineEstimatedTotal, Converter={StaticResource CurrencyConverter}}"
                                   FontWeight="SemiBold"
                                   VerticalAlignment="Center" />
                    </Border>
                </StackPanel>

                <Button Grid.Column="9"
                        Style="{StaticResource Button.Primary}"
                        Content="➕ Add"
                        Command="{Binding AddLineCommand}"
                        VerticalAlignment="Bottom"
                        Height="30"
                        Padding="12,0" />
            </Grid>
        </Border>

        <!-- 3. LINE ITEMS GRID -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6">
            <DataGrid ItemsSource="{Binding Items}"
                      BorderThickness="0"
                      AutoGenerateColumns="False"
                      CanUserAddRows="False"
                      SelectionMode="Single">
                <DataGrid.Columns>
                    <DataGridTextColumn Header="Product Name" Binding="{Binding ProductName}" Width="*" FontWeight="SemiBold" IsReadOnly="True" />
                    <DataGridTextColumn Header="Batch #" Binding="{Binding BatchNumber}" Width="120" />
                    <DataGridTextColumn Header="Expiry Date" Binding="{Binding ExpiryDate, StringFormat={}{0:yyyy-MM-dd}}" Width="110" />
                    <DataGridTextColumn Header="Quantity" Binding="{Binding Quantity, StringFormat={}{0:N2}}" Width="100" FontWeight="Bold" />
                    <DataGridTextColumn Header="Purchase Rate" Binding="{Binding PurchaseRate, Converter={StaticResource CurrencyConverter}}" Width="120" />
                    <DataGridTextColumn Header="Sale Rate" Binding="{Binding SuggestedSaleRate, Converter={StaticResource CurrencyConverter}}" Width="110" />
                    <DataGridTextColumn Header="Discount" Binding="{Binding DiscountAmount, Converter={StaticResource CurrencyConverter}}" Width="100" />
                    <DataGridTextColumn Header="Line Total" Binding="{Binding LineTotal, Converter={StaticResource CurrencyConverter}}" Width="130" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}" IsReadOnly="True" />

                    <DataGridTemplateColumn Header="Action" Width="80">
                        <DataGridTemplateColumn.CellTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource Button.Subtle}"
                                        Content="🗑️ Remove"
                                        Command="{Binding DataContext.RemoveLineCommand, RelativeSource={RelativeSource AncestorType=DataGrid}}"
                                        CommandParameter="{Binding}"
                                        Padding="4,2" />
                            </DataTemplate>
                        </DataGridTemplateColumn.CellTemplate>
                    </DataGridTemplateColumn>
                </DataGrid.Columns>
            </DataGrid>
        </Border>

        <!-- 4. TOTALS FOOTER & ACTIONS -->
        <Border Grid.Row="3"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="1"
                CornerRadius="6"
                Padding="16,12"
                Margin="0,12,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Status message -->
                    <ColumnDefinition Width="*" />
                    <!-- Subtotals & Net -->
                    <ColumnDefinition Width="Auto" />
                    <!-- Save Button -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Feedback -->
                <Border Grid.Column="0"
                        CornerRadius="4"
                        Padding="10,6"
                        Margin="0,0,20,0"
                        VerticalAlignment="Center"
                        Visibility="{Binding StatusMessage, Converter={StaticResource NullToVis}}">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Background" Value="#E6F4EA" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                    <Setter Property="Background" Value="#FDE8E8" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding StatusMessage}" FontSize="12" FontWeight="SemiBold">
                        <TextBlock.Style>
                            <Style TargetType="TextBlock">
                                <Setter Property="Foreground" Value="#137333" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                        <Setter Property="Foreground" Value="#9B1C1C" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBlock.Style>
                    </TextBlock>
                </Border>

                <!-- Financial Totals -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center" Margin="0,0,24,0">
                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Gross Total:" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" />
                        <TextBlock Text="{Binding GrossTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" FontSize="13" />
                    </StackPanel>

                    <StackPanel Margin="0,0,20,0">
                        <TextBlock Text="Discount:" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" />
                        <TextBlock Text="{Binding TotalDiscount, Converter={StaticResource CurrencyConverter}}" FontWeight="SemiBold" FontSize="13" Foreground="#D97706" />
                    </StackPanel>

                    <StackPanel>
                        <TextBlock Text="Net Payable Total:" Foreground="{StaticResource Brush.Text.Muted}" FontSize="11" />
                        <TextBlock Text="{Binding NetTotal, Converter={StaticResource CurrencyConverter}}" FontWeight="Bold" FontSize="18" Foreground="{StaticResource Brush.Primary}" />
                    </StackPanel>
                </StackPanel>

                <!-- Save & Post Button -->
                <Button Grid.Column="2"
                        Style="{StaticResource Button.Primary}"
                        Content="💾 Post Purchase Invoice (Ctrl+S)"
                        Command="{Binding SaveInvoiceCommand}"
                        Padding="24,10"
                        FontSize="14"
                        FontWeight="Bold" />
            </Grid>
        </Border>
    </Grid>
</UserControl>

