<Window x:Class="PharmaERP.Desktop.Views.DatabaseSetupWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
        xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
        mc:Ignorable="d"
        Title="PharmaERP — Database Setup &amp; First-Run Configuration"
        Width="720" Height="640"
        MinWidth="580" MinHeight="500"
        WindowStartupLocation="CenterScreen"
        ResizeMode="CanResizeWithGrip"
        Background="{StaticResource Brush.Background}"
        TextElement.FontFamily="{StaticResource FontFamily.Default}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{StaticResource Brush.Text.Primary}">

    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVis" />
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
    </Window.Resources>

    <Grid Margin="24,20">
        <Grid.RowDefinitions>
            <!-- Header -->
            <RowDefinition Height="Auto" />
            <!-- Scrollable Form Body -->
            <RowDefinition Height="*" />
            <!-- Footer Action Bar -->
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 1. HEADER -->
        <Border Grid.Row="0" Margin="0,0,0,14" Padding="0,0,0,10" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,0,0,1">
            <StackPanel>
                <TextBlock Text="PharmaERP Database Setup"
                           Style="{StaticResource Text.Display}"
                           FontSize="20"
                           FontWeight="Bold"
                           Foreground="{StaticResource Brush.Primary}" />
                <TextBlock Text="Configure SQL Server instance connectivity, initialize schema, and verify credentials."
                           Foreground="{StaticResource Brush.Text.Secondary}"
                           FontSize="12"
                           Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <!-- 2. BODY -->
        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" Margin="0,0,0,12" Padding="0,0,8,0">
            <StackPanel>

                <!-- STATUS MESSAGE BANNER -->
                <Border CornerRadius="6" Padding="14,10" Margin="0,0,0,14" BorderThickness="1">
                    <Border.Style>
                        <Style TargetType="Border">
                            <!-- Default Info -->
                            <Setter Property="Background" Value="#F0F9FF" />
                            <Setter Property="BorderBrush" Value="#BAE6FD" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:SetupStatusSeverity.Success}">
                                    <Setter Property="Background" Value="#F0FDF4" />
                                    <Setter Property="BorderBrush" Value="#BBF7D0" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:SetupStatusSeverity.Warning}">
                                    <Setter Property="Background" Value="#FFFBEB" />
                                    <Setter Property="BorderBrush" Value="#FDE68A" />
                                </DataTrigger>
                                <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:SetupStatusSeverity.Error}">
                                    <Setter Property="Background" Value="#FEF2F2" />
                                    <Setter Property="BorderBrush" Value="#FECACA" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>

                    <StackPanel>
                        <TextBlock Text="{Binding StatusMessage}"
                                   FontWeight="SemiBold"
                                   FontSize="12"
                                   TextWrapping="Wrap">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Foreground" Value="#0369A1" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:SetupStatusSeverity.Success}">
                                            <Setter Property="Foreground" Value="#15803D" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:SetupStatusSeverity.Warning}">
                                            <Setter Property="Foreground" Value="#B45309" />
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding StatusSeverity}" Value="{x:Static vm:SetupStatusSeverity.Error}">
                                            <Setter Property="Foreground" Value="#B91C1C" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>

                        <TextBlock Text="{Binding TechnicalDetails}"
                                   Visibility="{Binding TechnicalDetails, Converter={StaticResource NullToVis}}"
                                   Foreground="#7F1D1D"
                                   FontSize="11"
                                   Margin="0,4,0,0"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>

                <!-- SERVER & DATABASE CARD -->
                <Border Style="{StaticResource Card.Default}" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="SQL Server Connection" Style="{StaticResource Text.Subheading}" Margin="0,0,0,12" />

                        <!-- Server / Instance -->
                        <TextBlock Text="SQL Server Host / Instance Name *" Style="{StaticResource Form.Label}" />
                        <ComboBox ItemsSource="{Binding ServerSuggestions}"
                                  Text="{Binding Server, UpdateSourceTrigger=PropertyChanged}"
                                  IsEditable="True"
                                  MaxDropDownHeight="200"
                                  Height="32"
                                  Margin="0,0,0,12" />

                        <!-- Database Name -->
                        <TextBlock Text="Target Database Name *" Style="{StaticResource Form.Label}" />
                        <TextBox Text="{Binding Database, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,12" />

                        <!-- Authentication Method -->
                        <TextBlock Text="Authentication Mode *" Style="{StaticResource Form.Label}" Margin="0,0,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                            <RadioButton Content="Windows Authentication (Recommended)"
                                         IsChecked="{Binding IsWindowsAuth}"
                                         Margin="0,0,20,0"
                                         VerticalContentAlignment="Center" />
                            <RadioButton Content="SQL Server Authentication"
                                         IsChecked="{Binding IsSqlAuth}"
                                         VerticalContentAlignment="Center" />
                        </StackPanel>

                        <!-- SQL Authentication Credentials Panel -->
                        <StackPanel Visibility="{Binding IsSqlAuth, Converter={StaticResource BoolToVis}}" Margin="0,0,0,12">
                            <TextBlock Text="SQL Username *" Style="{StaticResource Form.Label}" />
                            <TextBox Text="{Binding UserName, UpdateSourceTrigger=PropertyChanged}"
                                     Height="32"
                                     Margin="0,0,0,10" />

                            <TextBlock Text="SQL Password *" Style="{StaticResource Form.Label}" />
                            <PasswordBox x:Name="SqlPasswordBox"
                                         PasswordChanged="SqlPasswordBox_PasswordChanged"
                                         Height="32"
                                         Margin="0,0,0,10" />

                            <TextBlock Text="Password will be protected using Windows DPAPI encryption on this PC."
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Muted}" />
                        </StackPanel>

                        <!-- Security Options -->
                        <WrapPanel Orientation="Horizontal" Margin="0,4,0,0">
                            <CheckBox Content="Trust Server Certificate (Recommended for local/self-signed)"
                                      IsChecked="{Binding TrustServerCertificate}"
                                      Margin="0,0,20,6"
                                      VerticalContentAlignment="Center" />
                            <CheckBox Content="Encrypt Connection"
                                      IsChecked="{Binding Encrypt}"
                                      Margin="0,0,0,6"
                                      VerticalContentAlignment="Center" />
                        </WrapPanel>
                    </StackPanel>
                </Border>

                <!-- FIRST-TIME REGIONAL & COMPANY PROFILE CARD -->
                <Border Style="{StaticResource Card.Default}"
                        Visibility="{Binding IsFirstTimeSetup, Converter={StaticResource BoolToVis}}"
                        Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="Initial Company &amp; Regional Setup" Style="{StaticResource Text.Subheading}" Margin="0,0,0,4" />
                        <TextBlock Text="Configured once upon creating a new database. Pakistani defaults are preselected."
                                   Foreground="{StaticResource Brush.Text.Secondary}"
                                   FontSize="11"
                                   Margin="0,0,0,12" />

                        <!-- Company Name -->
                        <TextBlock Text="Pharmacy / Company Name *" Style="{StaticResource Form.Label}" />
                        <TextBox Text="{Binding CompanyName, UpdateSourceTrigger=PropertyChanged}"
                                 Height="32"
                                 Margin="0,0,0,12" />

                        <Grid Margin="0,0,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="16" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>

                            <!-- Base Currency -->
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Base Currency *" Style="{StaticResource Form.Label}" />
                                <ComboBox ItemsSource="{Binding CuratedCurrencies}"
                                          SelectedItem="{Binding SelectedCurrency}"
                                          DisplayMemberPath="DisplayName"
                                          MaxDropDownHeight="220"
                                          Height="32" />
                            </StackPanel>

                            <!-- Default Language -->
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Default Language *" Style="{StaticResource Form.Label}" />
                                <ComboBox ItemsSource="{Binding SupportedLanguages}"
                                          SelectedItem="{Binding SelectedLanguage}"
                                          DisplayMemberPath="NativeName"
                                          MaxDropDownHeight="220"
                                          Height="32" />
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- FRIENDLY STRUCTURED CONNECTION SUMMARY CARD -->
                <Border Style="{StaticResource Card.Default}" Margin="0,0,0,8" Padding="14">
                    <StackPanel>
                        <TextBlock Text="Connection Summary" Style="{StaticResource Text.Subheading}" FontSize="13" Margin="0,0,0,8" />
                        <UniformGrid Columns="2" Margin="0,0,0,6">
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Server:" Style="{StaticResource Form.Label}" FontSize="11" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Server, FallbackValue='(Not configured)'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Target Database:" Style="{StaticResource Form.Label}" FontSize="11" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding Database, FallbackValue='(Not configured)'}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                            </StackPanel>
                            <StackPanel Margin="0,0,12,6">
                                <TextBlock Text="Authentication:" Style="{StaticResource Form.Label}" FontSize="11" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding AuthDisplay}" FontWeight="SemiBold" />
                            </StackPanel>
                            <StackPanel Margin="0,0,0,6">
                                <TextBlock Text="Security &amp; Encryption:" Style="{StaticResource Form.Label}" FontSize="11" Margin="0,0,0,2" />
                                <TextBlock Text="{Binding SecurityDisplay}" FontWeight="SemiBold" />
                            </StackPanel>
                        </UniformGrid>

                        <!-- Advanced Details Expander -->
                        <Expander Header="Advanced Connection Details (Masked Connection String)"
                                  IsExpanded="False"
                                  Margin="0,4,0,0"
                                  Foreground="{StaticResource Brush.Text.Secondary}"
                                  FontSize="11">
                            <Border Background="{StaticResource Brush.Surface.Muted}"
                                    BorderBrush="{StaticResource Brush.Border}"
                                    BorderThickness="1"
                                    CornerRadius="4"
                                    Padding="10"
                                    Margin="0,6,0,0">
                                <StackPanel>
                                    <TextBlock Text="Masked ADO.NET Connection String:" FontSize="10" Style="{StaticResource Form.Label}" Margin="0,0,0,4" />
                                    <TextBox Text="{Binding MaskedConnectionString, Mode=OneWay}"
                                             IsReadOnly="True"
                                             TextWrapping="Wrap"
                                             FontFamily="Consolas"
                                             FontSize="11"
                                             Background="Transparent"
                                             BorderThickness="0"
                                             Padding="0" />
                                </StackPanel>
                            </Border>
                        </Expander>
                    </StackPanel>
                </Border>

            </StackPanel>
        </ScrollViewer>

        <!-- 3. ACTION BAR -->
        <Border Grid.Row="2" Padding="0,12,0,0" BorderBrush="{StaticResource Brush.Border}" BorderThickness="0,1,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <!-- Left action buttons -->
                    <ColumnDefinition Width="*" />
                    <!-- Right action buttons -->
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Left actions: Test & Initialize -->
                <WrapPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Test Connection"
                            Command="{Binding TestConnectionCommand}"
                            Style="{StaticResource Button.Outline}"
                            Padding="14,8"
                            Margin="0,0,10,6" />

                    <Button Content="Create &amp; Initialize Database"
                            Command="{Binding InitializeDatabaseCommand}"
                            Style="{StaticResource Button.Outline}"
                            Padding="14,8"
                            Margin="0,0,10,6" />
                </WrapPanel>

                <!-- Right actions: Cancel & Proceed -->
                <WrapPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                    <Button Content="Cancel / Exit"
                            Command="{Binding CancelCommand}"
                            Style="{StaticResource Button.Outline}"
                            Padding="14,8"
                            Margin="0,0,10,6" />

                    <Button Content="Proceed to PharmaERP →"
                            Command="{Binding SaveAndProceedCommand}"
                            Style="{StaticResource Button.Primary}"
                            Padding="16,8"
                            Margin="0,0,0,6"
                            FontWeight="Bold" />
                </WrapPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
