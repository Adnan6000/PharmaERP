<Window x:Class="PharmaERP.Desktop.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:PharmaERP.Desktop.ViewModels"
        xmlns:views="clr-namespace:PharmaERP.Desktop.Views"
        xmlns:conv="clr-namespace:PharmaERP.Desktop.Converters"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainWindowViewModel}"
        Title="{Binding WindowTitle}"
        Height="840"
        Width="1280"
        MinHeight="680"
        MinWidth="1000"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource Brush.Background}"
        TextElement.FontFamily="{StaticResource FontFamily.Default}"
        TextElement.FontSize="{StaticResource FontSize.Body}"
        TextElement.Foreground="{StaticResource Brush.Text.Primary}">

    <Window.Resources>
        <conv:InverseBooleanToVisibilityConverter x:Key="InverseBoolToVis" />
        <conv:NullToVisibilityConverter x:Key="NullToVis" />
        <conv:ConnectionStatusToBrushConverter x:Key="StatusToBrush" />
        <BooleanToVisibilityConverter x:Key="BoolToVis" />

        <!-- ViewModel to View Mappings -->
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseEntryViewModel}">
            <views:PurchaseEntryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchasesViewModel}">
            <views:PurchasesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:PurchaseReturnsViewModel}">
            <views:PurchaseReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesEntryViewModel}">
            <views:SalesEntryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesViewModel}">
            <views:SalesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SalesReturnsViewModel}">
            <views:SalesReturnsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:InventoryStockViewModel}">
            <views:InventoryStockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:OpeningStockViewModel}">
            <views:OpeningStockView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ProductsViewModel}">
            <views:ProductsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CustomersViewModel}">
            <views:CustomersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SuppliersViewModel}">
            <views:SuppliersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ManufacturersViewModel}">
            <views:ManufacturersView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:CategoriesViewModel}">
            <views:CategoriesView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:UnitsViewModel}">
            <views:UnitsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Window.InputBindings>
        <KeyBinding Key="F2" Command="{Binding PurchaseEntryHotkeyCommand}" />
        <KeyBinding Key="F3" Command="{Binding SalesEntryHotkeyCommand}" />
        <KeyBinding Key="F5" Command="{Binding RefreshCommand}" />
        <KeyBinding Gesture="Ctrl+N" Command="{Binding NewItemCommand}" />
        <KeyBinding Key="Escape" Command="{Binding CloseDrawerCommand}" />
        <KeyBinding Gesture="Ctrl+S" Command="{Binding SaveItemCommand}" />
    </Window.InputBindings>

    <Grid>
        <Grid.RowDefinitions>
            <!-- Top App Header -->
            <RowDefinition Height="58" />
            <!-- Main Content Area -->
            <RowDefinition Height="*" />
            <!-- Bottom Status Bar -->
            <RowDefinition Height="30" />
        </Grid.RowDefinitions>

        <!-- TOP APP HEADER -->
        <Border Grid.Row="0"
                Background="{StaticResource Brush.Primary}"
                BorderBrush="{StaticResource Brush.Primary.Light}"
                BorderThickness="0,0,0,1"
                Padding="20,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Brand & Tagline -->
                <StackPanel Grid.Column="0"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.Accent}"
                            CornerRadius="5"
                            Width="30"
                            Height="30"
                            Margin="0,0,12,0">
                        <TextBlock Text="Rx"
                                   Foreground="{StaticResource Brush.Text.Inverse}"
                                   FontWeight="Bold"
                                   FontSize="15"
                                   HorizontalAlignment="Center"
                                   VerticalAlignment="Center" />
                    </Border>
                    <TextBlock Text="PharmaERP"
                               Foreground="{StaticResource Brush.Text.Inverse}"
                               FontSize="18"
                               FontWeight="Bold"
                               VerticalAlignment="Center" />
                    <TextBlock Text="— Pharmacy Management &amp; Accounting"
                               Foreground="{StaticResource Brush.Text.Muted}"
                               FontSize="12"
                               Margin="8,0,0,0"
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Center Profile Indicator -->
                <StackPanel Grid.Column="1"
                            Orientation="Horizontal"
                            HorizontalAlignment="Center"
                            VerticalAlignment="Center">
                    <Border Background="{StaticResource Brush.Primary.Light}"
                            CornerRadius="4"
                            Padding="10,4">
                        <StackPanel Orientation="Horizontal">
                            <TextBlock Text="Profile: "
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       FontSize="11" />
                            <TextBlock Text="{Binding ConnectionStore.ActiveProfile}"
                                       Foreground="{StaticResource Brush.Text.Inverse}"
                                       FontWeight="SemiBold"
                                       FontSize="11" />
                        </StackPanel>
                    </Border>
                </StackPanel>

                <!-- Right: Truthful Connection Health Indicator & Verify Button -->
                <StackPanel Grid.Column="2"
                            Orientation="Horizontal"
                            VerticalAlignment="Center">
                    <!-- Status Chip -->
                    <Border CornerRadius="4"
                            Padding="10,5"
                            Margin="0,0,10,0"
                            Background="{StaticResource Brush.Primary.Light}">
                        <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                            <!-- Status Indicator Dot -->
                            <Ellipse Width="8"
                                     Height="8"
                                     Margin="0,0,8,0"
                                     Fill="{Binding ConnectionStore.IsConnected, Converter={StaticResource StatusToBrush}}" />
                            <TextBlock Text="{Binding ConnectionStore.StatusText}"
                                       Foreground="{StaticResource Brush.Text.Inverse}"
                                       FontSize="12"
                                       FontWeight="SemiBold"
                                       VerticalAlignment="Center" />
                            <TextBlock Text="{Binding ConnectionStore.LatencyText, StringFormat=' ({0})'}"
                                       Foreground="{StaticResource Brush.Text.Muted}"
                                       FontSize="11"
                                       VerticalAlignment="Center" />
                        </StackPanel>
                    </Border>

                    <!-- Fast Connection Verify Button -->
                    <Button Style="{StaticResource Button.Outline}"
                            Content="Verify DB"
                            Command="{Binding RefreshCommand}"
                            Foreground="{StaticResource Brush.Text.Inverse}"
                            BorderBrush="{StaticResource Brush.Primary.Light}"
                            Padding="10,4"
                            FontSize="11" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- MAIN BODY: SIDEBAR + ACTIVE VIEW CONTENT -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <!-- Sidebar -->
                <ColumnDefinition Width="230" />
                <!-- Content Area -->
                <ColumnDefinition Width="*" />
            </Grid.ColumnDefinitions>

            <!-- SIDEBAR NAVIGATION -->
            <Border Grid.Column="0"
                    Background="{StaticResource Brush.Surface}"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="0,0,1,0"
                    Padding="12,14">
                <DockPanel LastChildFill="True">
                    <!-- Navigation Menu Items -->
                    <ScrollViewer VerticalScrollBarVisibility="Auto" DockPanel.Dock="Top">
                        <StackPanel>
                            <!-- OPERATIONS SECTION -->
                            <TextBlock Text="OPERATIONS"
                                       Style="{StaticResource Text.Muted}"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       Margin="10,0,0,6" />

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Dashboard">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📊" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Dashboard" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SalesEntry">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💳" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="POS Counter" FontWeight="Bold" Foreground="{StaticResource Brush.Primary}" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Sales">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🧾" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Sales History" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="SalesReturns">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🔄" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Sales Returns" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="PurchaseEntry">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🛒" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Purchase Entry (F2)" FontWeight="SemiBold" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Purchases">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📋" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Purchase Invoices" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="PurchaseReturns">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="↩️" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Purchase Returns" />
                                </StackPanel>
                            </Button>

                            <!-- INVENTORY SECTION -->
                            <TextBlock Text="INVENTORY"
                                       Style="{StaticResource Text.Muted}"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       Margin="10,14,0,6" />

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Inventory">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📦" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Stock &amp; Expiry Tracker" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="OpeningStock">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📥" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Opening Stock Entry" />
                                </StackPanel>
                            </Button>

                            <!-- MASTER REGISTERS -->
                            <TextBlock Text="MASTER REGISTERS"
                                       Style="{StaticResource Text.Muted}"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       Margin="10,14,0,6" />

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Products">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="💊" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Product Catalog" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Customers">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="👥" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Customers" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Suppliers">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🚚" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Suppliers" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Manufacturers">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏭" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Manufacturers" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Categories">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="🏷️" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Categories" />
                                </StackPanel>
                            </Button>

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Units">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="📏" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Units of Measure" />
                                </StackPanel>
                            </Button>

                            <!-- ADMINISTRATION -->
                            <TextBlock Text="ADMINISTRATION"
                                       Style="{StaticResource Text.Muted}"
                                       FontWeight="Bold"
                                       FontSize="10"
                                       Margin="10,14,0,6" />

                            <Button Style="{StaticResource Button.Nav}"
                                    Command="{Binding NavigateCommand}"
                                    CommandParameter="Settings">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="⚙️" FontSize="14" Margin="0,0,10,0" />
                                    <TextBlock Text="Database &amp; LAN" />
                                </StackPanel>
                            </Button>
                        </StackPanel>
                    </ScrollViewer>

                    <!-- Keyboard Shortcuts Quick Reference -->
                    <Border DockPanel.Dock="Bottom"
                            Background="{StaticResource Brush.Surface.Muted}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="1"
                            CornerRadius="6"
                            Padding="10"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Shortcuts"
                                       FontWeight="SemiBold"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Text.Primary}"
                                       Margin="0,0,0,4" />
                            <TextBlock Text="F3: POS Counter&#x0a;F2: Purchase Entry&#x0a;F5: Refresh&#x0a;Ctrl+N: New Record&#x0a;Esc: Close Drawer / Modal&#x0a;Ctrl+S: Save Record"
                                       FontSize="10"
                                       Foreground="{StaticResource Brush.Text.Secondary}"
                                       LineHeight="16" />
                        </StackPanel>
                    </Border>
                </DockPanel>
            </Border>

            <!-- DYNAMIC MAIN CONTENT WORKSPACE -->
            <ContentControl Grid.Column="1"
                            Content="{Binding CurrentViewModel}"
                            Focusable="False" />
        </Grid>

        <!-- BOTTOM STATUS BAR -->
        <Border Grid.Row="2"
                Background="{StaticResource Brush.Surface}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,1,0,0"
                Padding="16,0">
            <Grid VerticalAlignment="Center">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Profile: " Style="{StaticResource Text.Muted}" FontSize="11" />
                    <TextBlock Text="{Binding ConnectionStore.ActiveProfile}" FontWeight="SemiBold" FontSize="11" Margin="0,0,16,0" />

                    <TextBlock Text="Status: " Style="{StaticResource Text.Muted}" FontSize="11" />
                    <TextBlock Text="{Binding ConnectionStore.StatusText}" FontSize="11" Margin="0,0,16,0" />

                    <TextBlock Text="Latency: " Style="{StaticResource Text.Muted}" FontSize="11" />
                    <TextBlock Text="{Binding ConnectionStore.LatencyText}" FontSize="11" />
                </StackPanel>

                <TextBlock Grid.Column="1"
                           Text="PharmaERP v1.0.0"
                           Style="{StaticResource Text.Muted}"
                           FontSize="11"
                           VerticalAlignment="Center" />
            </Grid>
        </Border>
    </Grid>
</Window>

