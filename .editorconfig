# PharmaERP EditorConfig
# Root configuration for code style and analyzers

root = true

[*.cs]
# ==============================================================================
# Architectural Style: Explicit Constructors
# For services, repositories, ViewModels, and WPF classes, explicit constructors
# are preferred for maintainability, dependency injection transparency, and debugging.
# ==============================================================================
dotnet_style_prefer_primary_constructors = false:none
csharp_style_prefer_primary_constructors = false:none
dotnet_diagnostic.IDE0290.severity = none

[*.{cs,xaml,csproj,props,targets,slnx,json,md}]
end_of_line = crlf
charset = utf-8
insert_final_newline = true

